stack: {
  factory: {
    inputs: {
      defer-name: 'LOOKUP_DEFER'
      seed:       'LOOKUP_SEED'
      metadata: {
        name:          'LOOKUP_NAME'
        generate-name: 'LOOKUP_PREFIX'
        namespace:     'LOOKUP_NAMESPACE'
        labels: {
          'LOOKUP_LABEL_KEY': 'LOOKUP_LABEL_VALUE'
          'bad/key/null':     null
        }
        annotations: {
          'LOOKUP_ANNOTATION_KEY': 'arbitrary: / value'
          'bad/key/null':          null
        }
      }
    }
  }
  state: local {
    path: '.unobin/state'
  }
  encryption: noop {}
}
