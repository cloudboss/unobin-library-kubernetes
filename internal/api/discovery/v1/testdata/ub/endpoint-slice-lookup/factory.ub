factory: {
  imports: {
    discovery: 'github.com/cloudboss/unobin-library-kubernetes//api/discovery/v1'
    tokens:    'github.com/cloudboss/unobin-library-kubernetes//tests/compile/token'
  }
  library-configs: { discovery: { namespace: 'library-namespace' } }
  inputs: {
    defer-name: { type: boolean, default: false }
    seed:       { type: string, default: 'lookup' }
    metadata: {
      type: object(
        {
          name:          { type: optional(string) }
          generate-name: { type: optional(string) }
          namespace:     { type: optional(string) }
          labels:        { type: optional(map(optional(string))) }
          annotations:   { type: optional(map(optional(string))) }
        },
      )
    }
  }
  actions: {
    seed: tokens.issue {
      value: input.seed
    }
  }
  data-sources: {
    selected: discovery.endpoint-slice {
      metadata: {
        name:          if input.defer-name then action.seed.token else input.metadata.name
        generate-name: input.metadata.generate-name
        namespace:     input.metadata.namespace
        labels:        input.metadata.labels
        annotations:   input.metadata.annotations
      }
    }
  }
  outputs: {
    metadata:     { value: data-source.selected.metadata }
    address-type: { value: data-source.selected.address-type }
    endpoints:    { value: data-source.selected.endpoints }
    ports:        { value: data-source.selected.ports }
  }
}
