factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: { kubeconfig: input.kubeconfig, current-context: 'selected' } }
  inputs: {
    kubeconfig: { type: string }
    version:    { type: string }
  }
  data-sources: {
    cluster: core.server-version {
      version: input.version
    }
  }
}
