factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: { server: input.server, insecure-skip-tls-verify: true } }
  inputs:          { server: { type: string } }
  data-sources: {
    endpoint: core.service {
      metadata: { name: 'svc' }
    }
  }
  outputs: {
    metadata: { value: data-source.endpoint.metadata }
    spec:     { value: data-source.endpoint.spec }
    status:   { value: data-source.endpoint.status }
  }
}
