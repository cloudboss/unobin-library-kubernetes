factory: {
  imports: { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  inputs: {
    server:     { type: string }
    members:    { type: list(string) }
    expiration: { type: integer }
  }
  library-configs: { core: { server: input.server, insecure-skip-tls-verify: true } }
  resources: {
    seed: core.replication-controller {
      metadata: { name: 'seed' }
      spec:     { selector: {}, template: { metadata: {}, spec: {} } }
    }
    subject: core.replication-controller {
      metadata: { name: 'subject' }
      spec: {
        selector: {}
        template: {
          metadata: {}
          spec: {
            volume: [
              {
                name: 'projected'
                projected: {
                  sources: [
                    for item in input.members :
                    {
                      service-account-token: {
                        path:               item
                        audience:           resource.seed.metadata.annotations['value']
                        expiration-seconds: input.expiration
                      }
                    }
                  ]
                }
              },
            ]
          }
        }
      }
    }
  }
}
