factory: {
  imports: { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  inputs: {
    server: { type: string }
  }
  library-configs: { core: { server: input.server, insecure-skip-tls-verify: true } }
  resources: {
    seed: core.pod {
      metadata:     { name: 'seed' }
      spec:         {}
      target-state: ['Pending']
    }
    subject: core.pod {
      metadata: { name: 'subject' }
      spec: {
        volume: [
          {
            name: 'projected'
            projected: {
              sources: [
                for path in ['tmp'] :
                { service-account-token: { path: path } }
                when path == resource.seed.metadata.annotations['value']
              ]
            }
          },
        ]
      }
      target-state: ['Pending']
    }
  }
}
