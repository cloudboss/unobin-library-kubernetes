factory: {
  imports: { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: {
    core: { server: input.server token: input.token insecure-skip-tls-verify: true }
  }
  inputs: {
    server: { type: string }
    token: { type: string }
    metadata: { type: opaque }
    spec: { type: opaque }
    wait: { type: boolean }
  }
  resources: {
    endpoint: core.service {
      metadata: input.metadata
      spec: input.spec
      wait-for-load-balancer: input.wait
    }
  }
}
