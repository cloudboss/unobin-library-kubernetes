factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: { server: input.server } }
  actions: {
    seed: core.seed {
      metadata: input.metadata
    }
  }
  data-sources: {
    endpoint: core.namespace-info {
      metadata: action.seed.value
    }
  }
}
