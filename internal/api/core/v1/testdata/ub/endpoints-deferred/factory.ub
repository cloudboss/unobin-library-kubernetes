factory: {
  imports: { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  inputs: {
    server:            { type: string }
    name:              { type: string }
    seed:              { type: string }
    deferred-identity: { type: boolean }
    known-filter:      { type: string }
    resolve-port:      { type: boolean }
    port-key:          { type: string }
  }
  library-configs: {
    core: { server: input.server, insecure-skip-tls-verify: true }
  }
  resources: {
    seed: core.config-map {
      object: {
        metadata: { name: 'endpoints-seed' }
        data:     { value: input.seed }
      }
    }
    subject: core.endpoints {
      metadata: {
        name:        if input.deferred-identity then data-source.live.data['value'] else input.name
        annotations: { value: data-source.live.data['value'] }
      }
      ignore-labels: [input.known-filter]
      subset: if input.resolve-port
        then [
          {
            port: [
              {
                port: @core.lookup(
                  { selected: @core.to-number(data-source.live.data['value']) },
                  input.port-key,
                )
              },
            ]
          },
        ]
        else null
    }
  }
  data-sources: {
    live: core.config-map {
      @depends-on: [resource.seed]
      metadata:    { name: 'endpoints-seed' }
    }
  }
}
