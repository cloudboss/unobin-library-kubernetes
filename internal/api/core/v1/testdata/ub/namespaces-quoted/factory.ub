factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: {} }
  data-sources: {
    cluster: core.namespaces {
      'unknown namespace': 'unused'
    }
  }
  outputs: {
    names: { value: data-source.cluster.namespaces }
  }
}
