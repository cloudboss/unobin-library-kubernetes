factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: { server: input.server } }
  actions: {
    seed: core.seed {
      value: input.pending
    }
  }
  data-sources: {
    claim: core.persistent-volume-claim-info {
      metadata: {
        name:   input.name
        labels: { 'BAD.EXAMPLE/Key': action.seed.result, settled: input.label }
      }
    }
  }
}
