factory: {
  imports: { rbac: 'github.com/cloudboss/unobin-library-kubernetes//api/rbac/v1' }
  library-configs: {
    rbac: { server: input.server, insecure-skip-tls-verify: true }
  }
  inputs: {
    server:       { type: string }
    metadata:     { type: opaque }
    subject-name: { type: string, default: 'alice' }
  }
  resources: {
    binding: rbac.role-binding {
      metadata: input.metadata
      role-ref: { api-group: 'rbac.authorization.k8s.io', kind: 'Role', name: 'reader' }
      subject:  [{ kind: 'User', name: input.subject-name }]
    }
  }
}
