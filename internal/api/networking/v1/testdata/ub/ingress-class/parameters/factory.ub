factory: {
  imports: { networking: 'github.com/cloudboss/unobin-library-kubernetes//api/networking/v1' }
  library-configs: { networking: { server: input.server, insecure-skip-tls-verify: true } }
  inputs: {
    server:     { type: string }
    parameters: { type: optional(map(string)) }
  }
  resources: {
    class: networking.ingress-class {
      metadata: { name: 'parameters' }
      spec:     { controller: 'example.com/controller', parameters: input.parameters }
    }
  }
}
