factory: {
  imports: { networking: 'github.com/cloudboss/unobin-library-kubernetes//api/networking/v1' }
  library-configs: { networking: { server: input.server, insecure-skip-tls-verify: true } }
  inputs: {
    server:      { type: string }
    seed-prefix: { type: string }
    scope:       { type: optional(string) }
  }
  resources: {
    seed: networking.ingress-class {
      metadata: { generate-name: input.seed-prefix }
      spec:     { controller: 'example.com/controller' }
    }
    class: networking.ingress-class {
      metadata: { name: 'deferred' }
      spec: {
        controller: 'example.com/controller'
        parameters: {
          kind: 'ConfigMap'
          name: if resource.seed.name == 'seed-actual' then 'settings' else 'other'
          scope: if input.scope != null
            then input.scope
            else if resource.seed.name == 'seed-actual' then 'Cluster' else 'cluster'
        }
      }
    }
  }
}
