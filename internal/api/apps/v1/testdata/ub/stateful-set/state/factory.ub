factory: {
  imports: { apps: 'github.com/cloudboss/unobin-library-kubernetes//api/apps/v1' }
  library-configs: {
    apps: { server: input.server, token: input.token, insecure-skip-tls-verify: true }
  }
  inputs: {
    server:   { type: string }
    token:    { type: string }
    metadata: { type: opaque }
    spec:     { type: opaque }
  }
  resources: {
    workload: apps.stateful-set {
      metadata:           input.metadata
      spec:               input.spec
      ignore-labels:      ['ignored']
      ignore-annotations: ['ignored']
      wait-for-rollout:   false
      delete-timeout:     '2s'
    }
  }
}
