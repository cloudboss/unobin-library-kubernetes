factory: {
  imports:         { apps: 'github.com/cloudboss/unobin-library-kubernetes//api/apps/v1' }
  library-configs: { apps: { server: input.server, insecure-skip-tls-verify: true } }
  inputs:          { server: { type: string } }
  resources: {
    workload: apps.daemon-set {
      metadata: { name: 'workload' }
      spec: {
        template: {
          metadata: {}
          spec:     { volume: [{ name: 'scratch', empty-dir: { size-limit: 'malformed' } }] }
        }
      }
      wait-for-rollout: false
    }
  }
}
