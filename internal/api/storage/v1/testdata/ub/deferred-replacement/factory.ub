factory: {
  imports:         { storage: 'github.com/cloudboss/unobin-library-kubernetes//api/storage/v1' }
  library-configs: { storage: { server: input.server, insecure-skip-tls-verify: true } }
  inputs: {
    server:       { type: string }
    label-suffix: { type: string }
    policy:       { type: string }
  }
  resources: {
    seed: storage.storage-class {
      metadata:    { name: 'seed' }
      provisioner: 'seed/provisioner'
      parameters:  { policy: 'Delete' }
    }
    class: storage.storage-class {
      metadata: {
        name:   'example'
        labels: { source: $'{{ resource.seed.metadata.uid }}{{ input.label-suffix }}' }
      }
      provisioner:    'replacement.example/provisioner'
      reclaim-policy: input.policy
    }
  }
}
