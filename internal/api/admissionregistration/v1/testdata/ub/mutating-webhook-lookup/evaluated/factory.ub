factory: {
  imports: {
    admission: 'github.com/cloudboss/unobin-library-kubernetes//api/admissionregistration/v1'
    core:      'github.com/cloudboss/unobin-library-kubernetes//api/core/v1'
  }
  library-configs: { admission: {}, core: {} }
  inputs: {
    name:         { type: string, default: 'lookup.test' }
    annotations:  { type: map(optional(string)), default: { 'İ.COM/Key': 'unrestricted text' } }
    labels:       { type: map(optional(string)), default: { app: '', nullable: null } }
    defer-name:   { type: boolean, default: false }
    defer-label:  { type: boolean, default: false }
    label-key:    { type: string, default: 'pending' }
    use-metadata: { type: boolean, default: false }
    metadata:     { type: optional(opaque) }
  }
  resources: {
    seed: core.config-map {
      object: {
        metadata: { name: 'seed' }
        data:     { ready: 'true' }
      }
    }
  }
  data-sources: {
    lookup: admission.mutating-webhook-configuration {
      metadata: if input.use-metadata
        then @core.lookup({ value: input.metadata }, 'value')
        else {
          name: if input.defer-name then resource.seed.object.metadata.uid else input.name
          labels: if input.defer-label
            then { for key in [input.label-key] : key => resource.seed.object.metadata.uid }
            else input.labels
          annotations: input.annotations
        }
    }
  }
  outputs: {
    name:     { value: data-source.lookup.metadata.name }
    webhooks: { value: [ for hook in data-source.lookup.webhook : hook.name ] }
  }
}
