factory: {
  imports: {
    admission: 'github.com/cloudboss/unobin-library-kubernetes//api/admissionregistration/v1'
  }
  library-configs: {
    admission: {
      server:                   input.server
      token:                    input.token
      kubeconfig:               input.kubeconfig
      current-context:          input.current-context
      insecure-skip-tls-verify: true
    }
  }
  inputs: {
    server:          { type: string }
    token:           { type: string, default: 'current' }
    kubeconfig:      { type: optional(string), default: null }
    current-context: { type: optional(string), default: null }
    name:            { type: optional(string), default: null }
    prefix:          { type: optional(string), default: null }
    failure:         { type: string, default: 'Fail' }
    match:           { type: optional(string), default: null }
    label:           { type: string, default: 'initial' }
    update-timeout:  { type: optional(string), default: null }
  }
  resources: {
    subject: admission.validating-admission-policy {
      metadata: {
        name:          input.name
        generate-name: input.prefix
        labels:        { test: input.label }
        annotations:   { retained: 'configured' }
      }
      spec: {
        audit-annotations: []
        failure-policy:    input.failure
        match-constraints: { match-policy: input.match }
      }
      update-timeout: input.update-timeout
    }
  }
}
