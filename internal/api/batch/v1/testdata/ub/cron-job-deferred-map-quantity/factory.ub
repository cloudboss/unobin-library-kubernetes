factory: {
  imports:         { batch: 'github.com/cloudboss/unobin-library-kubernetes//api/batch/v1' }
  library-configs: { batch: { server: input.server, insecure-skip-tls-verify: true } }
  inputs:          { server: { type: string }, value: { type: string } }
  resources: {
    seed: batch.cron-job {
      metadata: { name: 'seed' }
      spec: {
        schedule:     '* * * * *'
        job-template: { metadata: {}, spec: { template: { metadata: {} } } }
      }
    }
    workload: batch.cron-job {
      metadata: { name: 'replacement' }
      spec: {
        schedule: '* * * * *'
        job-template: {
          metadata: {}
          spec: {
            template: {
              metadata: {}
              spec: {
                container: [
                  {
                    name:      'app'
                    resources: { requests: { cpu: resource.seed.metadata.annotations['value'] } }
                  },
                ]
              }
            }
          }
        }
      }
    }
  }
}
