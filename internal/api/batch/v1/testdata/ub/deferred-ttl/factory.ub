factory: {
  imports:         { batch: 'github.com/cloudboss/unobin-library-kubernetes//api/batch/v1' }
  library-configs: { batch: { server: input.server, insecure-skip-tls-verify: true } }
  inputs:          { server: { type: string }, value: { type: string } }
  resources: {
    seed: batch.job {
      metadata:            { name: 'seed' }
      spec:                { template: { metadata: {} } }
      wait-for-completion: false
    }
    workload: batch.job {
      metadata: { name: 'replacement' }
      spec: {
        ttl-seconds-after-finished: resource.seed.metadata.annotations['value']
        template:                   { metadata: {} }
      }
      wait-for-completion: false
    }
  }
}
