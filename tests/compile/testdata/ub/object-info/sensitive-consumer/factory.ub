factory: {
  imports: {
    core:    'github.com/cloudboss/unobin-library-kubernetes//api/core/v1'
    dynamic: 'github.com/cloudboss/unobin-library-kubernetes//dynamic'
  }
  library-configs: {
    core:    { server: input.server }
    dynamic: { server: input.server }
  }
  inputs: {
    server:      { type: string }
    api-version: { type: string }
    kind:        { type: string }
    lookup-name: { type: string }
  }
  data-sources: {
    endpoint: dynamic.object-info {
      api-version: input.api-version
      kind:        input.kind
      metadata:    { name: input.lookup-name }
    }
  }
  resources: {
    consumer: core.config-map {
      object: {
        metadata: { name: 'consumer' }
        data:     { observed: @core.to-json(data-source.endpoint.object) }
      }
    }
  }
}
