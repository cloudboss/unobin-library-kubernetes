factory: {
  imports: {
    core:    'github.com/cloudboss/unobin-library-kubernetes//api/core/v1'
    dynamic: 'github.com/cloudboss/unobin-library-kubernetes//dynamic'
  }
  library-configs: {
    core:    { server: input.server }
    dynamic: { server: input.server }
  }
  inputs: { server: { type: string }, lookup-name: { type: string } }
  resources: {
    seed: core.config-map {
      object: {
        metadata: { name: 'seed', namespace: 'default' }
      }
    }
  }
  data-sources: {
    endpoint: dynamic.object-info {
      api-version: 'v1'
      kind:        'Secret'
      metadata:    { name: resource.seed.object.metadata.uid }
    }
  }
  outputs: { observed: { value: data-source.endpoint.object } }
}
