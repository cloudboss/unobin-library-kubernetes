factory: {
  imports: { scheduling: 'github.com/cloudboss/unobin-library-kubernetes//api/scheduling/v1' }
  library-configs: { scheduling: { server: 'https://127.0.0.1:1' } }
  inputs:          { label: { type: string } }
  resources: {
    class: scheduling.priority-class {
      metadata: { name: 'Invalid', labels: { key: input.label } }
      value:    0
    }
  }
}
