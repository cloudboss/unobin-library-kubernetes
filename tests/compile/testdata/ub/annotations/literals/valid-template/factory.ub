factory: {
  imports:         { dynamic: 'github.com/cloudboss/unobin-library-kubernetes//dynamic' }
  library-configs: { dynamic: {} }
  resources: {
    selection: dynamic.annotations {
      api-version:          '/v1'
      kind:                 'ConfigMap'
      metadata:             { name: 'example' }
      template-annotations: { note: 'value' }
    }
  }
  outputs: {
    object-annotations:   { value: resource.selection.annotations }
    workload-annotations: { value: resource.selection.template-annotations }
  }
}
