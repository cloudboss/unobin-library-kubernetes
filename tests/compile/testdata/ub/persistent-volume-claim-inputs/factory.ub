factory: {
  imports: { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: {
    core: {
      server:                   input.server
      namespace:                'elsewhere'
      insecure-skip-tls-verify: true
      token:                    'pvc-test-token'
    }
  }
  inputs: {
    server: { type: string }
    metadata: {
      type: object(
        {
          name:        { type: string }
          namespace:   { type: optional(string) }
          annotations: { type: map(string) }
          labels:      { type: map(string) }
        },
      )
    }
  }
  resources: {
    anchor: core.config-map {
      object: { metadata: { name: 'fixed', namespace: 'default' } }
    }
  }
  data-sources: {
    claim: core.persistent-volume-claim {
      metadata: input.metadata
    }
  }
  outputs: {
    metadata: { value: data-source.claim.metadata }
    spec:     { value: data-source.claim.spec }
  }
}
