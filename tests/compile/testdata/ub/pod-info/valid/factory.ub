factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: {} }
  data-sources: {
    endpoint: core.pod-info {
      metadata: {
        name:          'valid.pod'
        generate-name: 'pref@-'
        namespace:     ''
        labels:        { 'example.com/Key': '', 'bad key': null }
        annotations:   { 'EXAMPLE.İK/Key': 'value text', 'bad key': null }
      }
    }
  }
  outputs: {
    name:             { value: data-source.endpoint.metadata.name }
    prefix:           { value: data-source.endpoint.metadata.generate-name }
    namespace:        { value: data-source.endpoint.metadata.namespace }
    labels:           { value: data-source.endpoint.metadata.labels }
    annotations:      { value: data-source.endpoint.metadata.annotations }
    uid:              { value: data-source.endpoint.metadata.uid }
    generation:       { value: data-source.endpoint.metadata.generation }
    resource-version: { value: data-source.endpoint.metadata.resource-version }
    status:           { value: data-source.endpoint.status }
    containers:       { value: data-source.endpoint.spec?.container }
    os:               { value: data-source.endpoint.spec?.os?.name }
    node:             { value: data-source.endpoint.spec?.node-name }
    volumes:          { value: data-source.endpoint.spec?.volume }
  }
}
