factory: {
  imports:         { k: 'github.com/cloudboss/unobin-library-kubernetes//api/apps/v1' }
  library-configs: { k: {} }
  resources: {
    subject: k.deployment {
      metadata: { name: 'test' }
      spec: {
        template: {
          metadata: {}
          spec:     { container: [{ name: 'test', liveness-probe: { period-seconds: 0 } }] }
        }
      }
    }
  }
}
