factory: {
  imports:         { batch: 'github.com/cloudboss/unobin-library-kubernetes//api/batch/v1' }
  library-configs: { batch: {} }
  resources: {
    subject: batch.cron-job {
      metadata: { name: 'test' }
      spec: {
        schedule: '* * * * *'
        job-template: {
          metadata: {}
          spec: {
            pod-failure-policy: { rule: [{ on-exit-codes: { values: [0] } }] }
            template:           { metadata: {} }
          }
        }
      }
    }
  }
}
