factory: {
  imports:         { discovery: 'github.com/cloudboss/unobin-library-kubernetes//api/discovery/v1' }
  library-configs: { discovery: {} }
  inputs:          { zone: { type: string } }
  resources: {
    slice: discovery.endpoint-slice {
      metadata:     { name: 'demo' }
      address-type: 'IPv4'
      endpoints:    [{ addresses: ['192.0.2.10'], hostname: 'INVALID', zone: input.zone }]
      ports:        [{ port: '80', app-protocol: 'http' }]
    }
  }
}
