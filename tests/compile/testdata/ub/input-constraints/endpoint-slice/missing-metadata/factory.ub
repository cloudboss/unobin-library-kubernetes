factory: {
  imports:         { discovery: 'github.com/cloudboss/unobin-library-kubernetes//api/discovery/v1' }
  library-configs: { discovery: {} }
  resources: {
    slice: discovery.endpoint-slice {
      address-type: 'IPv4'
      endpoints:    [{ addresses: [] }]
      ports:        [{ port: '80', app-protocol: '' }]
    }
  }
}
