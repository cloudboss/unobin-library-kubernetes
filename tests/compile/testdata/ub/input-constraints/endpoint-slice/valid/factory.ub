factory: {
  imports:         { discovery: 'github.com/cloudboss/unobin-library-kubernetes//api/discovery/v1' }
  library-configs: { discovery: {} }
  resources: {
    ipv4: discovery.endpoint-slice {
      metadata:     { name: 'demo.ipv4' }
      address-type: 'IPv4'
      endpoints:    [{ addresses: [], target-ref: { name: 'pod' } }]
      ports:        [{ port: '+0090', app-protocol: '' }]
    }
    ipv6: discovery.endpoint-slice {
      metadata:     { generate-name: 'demo-' }
      address-type: 'IPv6'
      endpoints:    [{ addresses: ['2001:db8::1'] }]
      ports:        [{ port: '-0', app-protocol: 'http' }]
    }
    fqdn: discovery.endpoint-slice {
      metadata: {
        name:        'demo.fqdn'
        annotations: { 'Example.COM/Name': 'value' }
        labels:      { 'example.com/Name': '' }
      }
      address-type: 'FQDN'
      endpoints:    [{ addresses: ['main.example.com'] }]
      ports: [
        { port: '2147483648', protocol: 'TCP', app-protocol: 'http' },
        { port: '80', protocol: 'UDP', app-protocol: 'http' },
        { port: '81', protocol: 'SCTP', app-protocol: 'http' },
      ]
    }
  }
  outputs: {
    type:      { value: resource.ipv4.address-type }
    endpoints: { value: resource.ipv6.endpoints }
    ports:     { value: resource.fqdn.ports }
  }
}
