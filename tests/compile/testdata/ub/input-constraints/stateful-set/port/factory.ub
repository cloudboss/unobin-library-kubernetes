factory: {
  imports:         { apps: 'github.com/cloudboss/unobin-library-kubernetes//api/apps/v1' }
  library-configs: { apps: {} }
  resources: {
    workload: apps.stateful-set {
      metadata: { name: 'example' }
      spec: {
        selector:     {}
        service-name: 'example'
        template: {
          metadata: {}
          spec:     { container: [{ name: 'app', port: [{ container-port: 4294967297 }] }] }
        }
      }
    }
  }
}
