factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: {} }
  resources: {
    subject: core.config-map-data {
      object: { metadata: { name: 'test' }, data: {} }
    }
    text: core.config-map-data {
      field-manager: 'manager'
      force:         true
      object:        { metadata: { name: 'dotted.name', namespace: '' }, data: { empty: '' } }
    }
  }
  outputs: {
    server:      { value: resource.subject.server }
    api-version: { value: resource.subject.api-version }
    kind:        { value: resource.subject.kind }
    name:        { value: resource.subject.object.metadata.name }
    namespace:   { value: resource.text.object.metadata.namespace }
    uid:         { value: resource.text.object.metadata.uid }
    data:        { value: resource.text.object.data.empty }
  }
}
