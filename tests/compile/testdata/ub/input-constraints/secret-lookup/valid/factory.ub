factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: {} }
  data-sources: {
    endpoint: core.secret {
      metadata: {
        name: '''\-
          aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
          aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
          aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
          '''
        generate-name: 'ppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppp'
        labels:        { 'valid.example/Case': '', '?': null }
        annotations:   { 'İ.K/Key': 'arbitrary', '?': null }
      }
      binary-data: { bytes: 'not base64', 'arbitrary selector key': '', unused: null }
    }
    masked: core.secret {
      metadata: {
        name:          'valid.dotted'
        generate-name: 'ppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppA-'
        namespace:     'UPPER'
      }
    }
    optional: core.secret {
      metadata:    { name: null, generate-name: null, namespace: null }
      binary-data: null
    }
  }
  outputs: {
    metadata:  { value: data-source.endpoint.metadata }
    data:      { value: data-source.endpoint.data }
    binary:    { value: data-source.endpoint.binary-data }
    type:      { value: data-source.endpoint.type }
    immutable: { value: data-source.endpoint.immutable }
  }
}
