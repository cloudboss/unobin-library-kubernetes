factory: {
  imports:         { k: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { k: {} }
  resources: {
    subject: k.service {
      metadata: { name: 'test' }
      spec: {
        port: [
          { port: 1, node-port: 0, protocol: 'UDP' },
          { port: 65535, node-port: 65535, protocol: 'SCTP' },
        ]
        health-check-node-port:  1
        session-affinity-config: { client-ip: { timeout-seconds: 86400 } }
      }
    }
  }
}
