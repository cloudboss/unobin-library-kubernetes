factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: {} }

  resources: {
    subject: core.limit-range {
      object: {
        metadata: { name: 'dotted.name' }
        spec: {
          limit: [
            {
              type:                    'Container'
              default:                 { cpu: '0.5' }
              default-request:         { cpu: '100m' }
              max:                     { memory: '1Gi' }
              max-limit-request-ratio: { cpu: '2' }
              min:                     { cpu: '0' }
            },
            { type: 'Pod' },
            { type: 'Pod', default-request: {} },
            {},
          ]
        }
      }
    }
  }
  outputs: { name: { value: resource.subject.object.metadata.name } }
}
