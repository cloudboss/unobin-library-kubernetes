factory: {
  imports:         { k: 'github.com/cloudboss/unobin-library-kubernetes//api/rbac/v1' }
  library-configs: { k: {} }
  resources: {
    subject: k.role-binding {
      metadata: { generate-name: 'test-' }
      role-ref: { api-group: 'rbac.authorization.k8s.io', kind: 'Role', name: 'reader' }
      subject:  [{ kind: 'User', name: 'reader' }]
    }
  }
}
