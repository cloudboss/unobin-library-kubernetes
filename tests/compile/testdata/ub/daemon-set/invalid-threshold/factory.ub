factory: {
  imports:         { apps: 'github.com/cloudboss/unobin-library-kubernetes//api/apps/v1' }
  library-configs: { apps: {} }
  resources: {
    workload: apps.daemon-set {
      metadata: { name: 'example' }
      spec: {
        strategy: { rolling-update: { max-surge: '00' } }
        template: { metadata: {}, spec: {} }
      }
    }
  }
}
