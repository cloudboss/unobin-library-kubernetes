factory: {
  imports:         { apps: 'github.com/cloudboss/unobin-library-kubernetes//api/apps/v1' }
  library-configs: { apps: {} }
  inputs: {
    name:      { type: string }
    threshold: { type: string }
    port:      { type: integer }
  }
  resources: {
    workload: apps.daemon-set {
      metadata: { name: input.name }
      spec: {
        strategy: { rolling-update: { max-unavailable: input.threshold } }
        template: {
          metadata: {}
          spec: {
            container: [{ name: 'app', port: [{ container-port: input.port }] }]
          }
        }
      }
    }
  }
}
