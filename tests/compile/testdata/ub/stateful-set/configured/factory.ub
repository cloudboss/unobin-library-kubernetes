factory: {
  imports:         { apps: 'github.com/cloudboss/unobin-library-kubernetes//api/apps/v1' }
  library-configs: { apps: { server: 'http://127.0.0.1:1', insecure-skip-tls-verify: true } }
  inputs: {
    name:      { type: string, default: 'example' }
    revision:  { type: integer, default: 1 }
    policy:    { type: string, default: 'OrderedReady' }
    minimum:   { type: integer, default: 0 }
    port:      { type: integer, default: 8080 }
    claim:     { type: string, default: 'data' }
    retention: { type: string, default: 'Retain' }
    restart:   { type: string, default: 'Always' }
  }
  resources: {
    workload: apps.stateful-set {
      metadata: { name: input.name }
      spec: {
        selector:                                 {}
        service-name:                             'example'
        revision-history-limit:                   input.revision
        pod-management-policy:                    input.policy
        min-ready-seconds:                        input.minimum
        persistent-volume-claim-retention-policy: { when-scaled: input.retention }
        volume-claim-template: [
          {
            metadata: { name: input.claim }
            spec:     { access-modes: ['ReadWriteOnce'], resources: {} }
          },
        ]
        template: {
          metadata: {}
          spec: {
            restart-policy: input.restart
            container:      [{ name: 'app', port: [{ container-port: input.port }] }]
          }
        }
      }
      wait-for-rollout: false
    }
  }
}
