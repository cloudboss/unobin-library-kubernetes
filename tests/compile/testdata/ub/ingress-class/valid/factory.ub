factory: {
  imports: { networking: 'github.com/cloudboss/unobin-library-kubernetes//api/networking/v1' }
  library-configs: { networking: {} }
  resources: {
    explicit: networking.ingress-class {
      metadata: { name: 'valid.dotted.name', annotations: { 'Example.COM/Mixed': 'any value' } }
      spec:     { controller: 'example.com/controller' }
    }
    generated: networking.ingress-class {
      metadata: { generate-name: 'generated-', labels: { 'example.com/Key': '' } }
      spec: {
        controller: 'example.com/controller'
        parameters: {
          api-group: 'example.com'
          kind:      'IngressParameters'
          name:      'settings'
          scope:     'Cluster'
        }
      }
      ignore-labels:      ['^example[.]com/']
      ignore-annotations: ['^generated-']
    }
    namespaced: networking.ingress-class {
      metadata: { name: 'namespaced' }
      spec: {
        parameters: {
          kind:      'ConfigMap'
          name:      'settings'
          scope:     'Namespace'
          namespace: 'default'
        }
      }
    }
    api-owned: networking.ingress-class {
      metadata: { name: 'api-owned' }
      spec: {
        controller: 'invalid controller'
        parameters: { kind: 'ConfigMap', name: 'settings', namespace: '' }
      }
    }
  }
  outputs: {
    name:        { value: resource.generated.name }
    uid:         { value: resource.generated.uid }
    server:      { value: resource.generated.server }
    api-version: { value: resource.generated.api-version }
    kind:        { value: resource.generated.kind }
    metadata:    { value: resource.generated.metadata }
    spec:        { value: resource.generated.spec }
  }
}
