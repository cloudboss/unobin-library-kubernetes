factory: {
  imports: { networking: 'github.com/cloudboss/unobin-library-kubernetes//api/networking/v1' }
  library-configs: { networking: {} }
  resources: {
    missing-metadata: networking.ingress-class {
      spec: {}
    }
    missing-spec: networking.ingress-class {
      metadata: { name: 'class' }
    }
    missing-parameter-kind: networking.ingress-class {
      metadata: { name: 'class' }
      spec:     { parameters: { name: 'settings' } }
    }
    missing-parameter-name: networking.ingress-class {
      metadata: { name: 'class' }
      spec:     { parameters: { kind: 'ConfigMap' } }
    }
    list-spec: networking.ingress-class {
      metadata: { name: 'class' }
      spec:     [{}]
    }
    list-parameters: networking.ingress-class {
      metadata: { name: 'class' }
      spec:     { parameters: [{ kind: 'ConfigMap', name: 'settings' }] }
    }
    map-values: networking.ingress-class {
      metadata: { name: 'class', labels: { key: 1 }, annotations: { key: true } }
      spec:     {}
    }
    wrong-spelling: networking.ingress-class {
      metadata: { generateName: 'class-' }
      spec:     {}
    }
    server-field: networking.ingress-class {
      metadata: { name: 'class', uid: 'value', namespace: 'default' }
      spec:     {}
    }
  }
}
