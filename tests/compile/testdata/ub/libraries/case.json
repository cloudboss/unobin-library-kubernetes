{
  "name": "libraries",
  "factoryPath": "src",
  "libraryPath": "example.com/kubernetes/libraries",
  "build": true,
  "commands": [
    {
      "name": "validate",
      "args": ["validate", "-c", "stacks/dev.ub"],
      "stdout": "want/validate.txt",
      "stderr": "want/validate.stderr"
    },
    {
      "name": "plan",
      "args": ["plan", "-c", "stacks/dev.ub", "-o", "plan.ubp"],
      "stdout": "want/plan.txt",
      "stderr": "want/plan.stderr"
    },
    {
      "name": "apply",
      "args": ["apply", "plan.ubp", "--parallelism", "1"],
      "stdout": "want/apply.txt",
      "stderr": "want/apply.stderr"
    },
    {
      "name": "output",
      "args": ["output", "--format", "json", "-c", "stacks/dev.ub"],
      "stdout": "want/output.json",
      "stderr": "want/output.stderr",
      "normalize": "json"
    }
  ],
  "deterministic": true
}
