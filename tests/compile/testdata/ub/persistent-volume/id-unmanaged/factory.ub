factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: {} }
  resources: {
    volume: core.persistent-volume {

      object: {
        metadata: { name: 'volume' }
        spec: {
          capacity:     { storage: '1Gi' }
          access-modes: ['ReadWriteOnce']
          persistent-volume-source: {
            azure-disk: {
              caching-mode:  'None'
              data-disk-uri: '/providers/Microsoft.Compute/disks/disk'
              disk-name:     'disk'
              kind:          'Shared'
            }
          }
        }
      }
    }
  }
}
