stack: {
  factory: {
    inputs: {
      object: {
        metadata: { name: 'volume' }
        spec: {
          access-modes: ['ReadWriteOnce']
          capacity:     { storage: '1Gi' }
          persistent-volume-source: {
            azure-disk: {
              disk-name:     'disk'
              caching-mode:  'None'
              data-disk-uri: 'https://blob.core.windows.net/container/disk'
              kind:          'Managed'
            }
          }
        }
      }
    }
  }
  state: local {
    path: '.unobin/state'
  }
  encryption: noop {}
}
