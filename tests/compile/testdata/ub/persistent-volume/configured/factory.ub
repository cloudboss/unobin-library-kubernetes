factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: { server: input.server, insecure-skip-tls-verify: true } }
  inputs: {
    server: { type: string, default: 'https://unused.invalid' }
    object: { type: opaque }
  }
  resources: {
    volume: core.persistent-volume {
      object: @core.lookup({ volume: input.object }, 'volume')
    }
  }
}
