stack: {
  factory: {
    inputs: {
      server: 'https://api-placeholder.invalid'
      object: {
        metadata: { name: 'volume' }
        spec: {
          access-modes:             ['ReadWriteOnce']
          capacity:                 { storage: '1Gi' }
          persistent-volume-source: { csi: { volume-handle: 'volume' } }
        }
      }
    }
  }
  state: local {
    path: '.unobin/state'
  }
  encryption: noop {}
}
