factory: {
  imports: { networking: 'github.com/cloudboss/unobin-library-kubernetes//api/networking/v1' }
  library-configs: { networking: {} }
  data-sources: {
    endpoint: networking.ingress {
      metadata: {
        name:        'lookup.example'
        namespace:   ''
        annotations: { 'İK.Example/İK': 'arbitrary annotation value', 'bad key': null }
        labels:      { 'example.com/Mixed_Case': 'a_b-c.d2', empty: '', 'bad key': null }
      }
    }
    boundary: networking.ingress {
      metadata: {
        name: '''\-
          aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
          aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
          aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
          '''
        annotations: {
          'KKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKKK/İİİİİİİİİİİİİİİİİİİİİİİİİİİİİİİİİİİİİİİİİİİİİİİİİİİİİİİİİİİİİİİ': '''>-
            arbitrary annotation value
            '''
        }
        labels: {
          '': '''\-
            vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv
            '''
        }
      }
    }
    omitted: networking.ingress {
      metadata: {}
    }
    nullable: networking.ingress {
      metadata: { name: null, namespace: null, annotations: null, labels: null }
    }
  }
  outputs: {
    metadata: { value: data-source.endpoint.metadata }
    spec:     { value: data-source.endpoint.spec }
    status:   { value: data-source.endpoint.status }
  }
}
