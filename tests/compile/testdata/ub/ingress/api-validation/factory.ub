factory: {
  imports: { networking: 'github.com/cloudboss/unobin-library-kubernetes//api/networking/v1' }
  library-configs: { networking: {} }
  resources: {
    routing: networking.ingress {
      metadata: { name: 'valid', namespace: 'INVALID NAMESPACE' }
      spec: {
        rule: [{ host: 'BAD HOST', http: { path: [{ path: 'relative', path-type: 'Exact' }] } }]
        default-backend: {
          resource: { api-group: '', kind: '', name: '' }
          service:  { name: '', port: { number: 4294967296, name: '80' } }
        }
      }
    }
  }
}
