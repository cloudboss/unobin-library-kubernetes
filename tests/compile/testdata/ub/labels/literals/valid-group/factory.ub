factory: {
  imports:         { dynamic: 'github.com/cloudboss/unobin-library-kubernetes//dynamic' }
  library-configs: { dynamic: {} }
  resources: {
    selection: dynamic.labels {
      api-version:   'example.io/v2'
      kind:          'Widget'
      metadata:      { name: 'example' }
      labels:        {}
      field-manager: 'team manager'
    }
  }
  outputs: { observed: { value: resource.selection.labels } }
}
