factory: {
  imports:         { rbac: 'github.com/cloudboss/unobin-library-kubernetes//api/rbac/v1' }
  library-configs: { rbac: { server: 'https://127.0.0.1:1' } }
  resources: {
    seed: rbac.cluster-role-binding {
      metadata: { generate-name: 'seed-' }
      role-ref: { api-group: 'rbac.authorization.k8s.io', kind: 'ClusterRole', name: 'reader' }
      subject:  [{ kind: 'Custom', name: 'seed' }]
    }
    binding: rbac.cluster-role-binding {
      metadata: { generate-name: resource.seed.subject[0].api-group }
      role-ref: { api-group: 'rbac.authorization.k8s.io', kind: 'ClusterRole', name: 'reader' }
      subject:  [{ kind: 'User', name: 'alice' }]
    }
  }
}
