factory: {
  description: '''>-
    Reads a related ConfigMap and a missing ConfigMap without changing either lookup.
    '''
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: {} }
  inputs:          { value: { type: string }, binary-value: { type: string } }
  resources: {
    settings: core.config-map {
      object: {
        metadata:    { name: 'unobin-it-config-map-info', namespace: 'default' }
        data:        { value: input.value, unicode: '雪', empty-text: '' }
        binary-data: { bytes: input.binary-value, empty-bytes: '' }
      }
    }
  }
  data-sources: {
    existing: core.config-map {
      metadata: {
        name:        resource.settings.object.metadata.name
        namespace:   resource.settings.object.metadata.namespace
        annotations: { 'EXAMPLE.COM/Lookup': 'not-a-selector' }
        labels:      { lookup: 'not-a-selector' }
      }
      immutable: true
    }
    missing: core.config-map {
      metadata:  { name: 'unobin-it-config-map-info-absent', namespace: 'default' }
      immutable: true
    }
  }
  outputs: {
    metadata:            { value: data-source.existing.metadata }
    data:                { value: data-source.existing.data }
    binary-data:         { value: data-source.existing.binary-data }
    immutable:           { value: data-source.existing.immutable }
    missing-metadata:    { value: data-source.missing.metadata }
    missing-data:        { value: data-source.missing.data }
    missing-binary-data: { value: data-source.missing.binary-data }
    missing-immutable:   { value: data-source.missing.immutable }
  }
}
