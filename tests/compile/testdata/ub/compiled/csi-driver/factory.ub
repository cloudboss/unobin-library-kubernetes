factory: {
  imports:         { storage: 'github.com/cloudboss/unobin-library-kubernetes//api/storage/v1' }
  library-configs: { storage: {} }
  inputs: {
    revision: { type: string }
    spec: {
      type: optional(object({ attach-required: boolean, pod-info-on-mount: optional(boolean) }))
    }
  }
  resources: {
    driver: storage.csi-driver {
      metadata: {
        generate-name: 'unobin-it-csi-'
        labels:        { 'test.unobin.cloudboss.io/scenario': 'storage-v1-csi-driver' }
        annotations:   { 'test.unobin.cloudboss.io/revision': input.revision }
      }
      spec: input.spec
    }
  }
  outputs: {
    name: { value: resource.driver.metadata.name }
    uid:  { value: resource.driver.metadata.uid }
    spec: { value: resource.driver.spec }
  }
}
