factory: {
  imports:         { apps: 'github.com/cloudboss/unobin-library-kubernetes//api/apps/v1' }
  library-configs: { apps: {} }
  inputs: {
    image:            { type: string }
    epoch:            { type: string }
    memory:           { type: string }
    wait-for-rollout: { type: boolean, default: true }
  }
  resources: {
    workload: apps.daemon-set {
      metadata: {
        name:      'unobin-it-daemon-set'
        namespace: 'default'
        labels:    { app: 'unobin-it-daemon-set' }
      }
      spec: {
        revision-history-limit: 0
        selector:               { match-labels: { app: 'unobin-it-daemon-set' } }
        template: {
          metadata: { labels: { app: 'unobin-it-daemon-set' } }
          spec: {
            container: [
              {
                name:      'app'
                image:     input.image
                resources: { requests: { memory: input.memory } }
              },
            ]
            volume: [{ name: 'scratch', empty-dir: { size-limit: '1024Ki' } }]
          }
        }
      }
      wait-for-rollout: input.wait-for-rollout
      create-timeout:   '3m'
      update-timeout:   '3m'
      delete-timeout:   '30s'
    }
    replacement: apps.daemon-set {
      metadata: {
        name:      'unobin-it-daemon-set-replace'
        namespace: 'default'
        labels:    { app: 'unobin-it-daemon-set-replace' }
      }
      spec: {
        revision-history-limit: 0
        selector: { match-labels: { app: 'unobin-it-daemon-set-replace', epoch: input.epoch } }
        template: {
          metadata: { labels: { app: 'unobin-it-daemon-set-replace', epoch: input.epoch } }
          spec: {
            container: [
              {
                name:      'app'
                image:     input.image
                resources: { requests: { memory: input.memory } }
              },
            ]
            volume: [{ name: 'scratch', empty-dir: { size-limit: '1024Ki' } }]
          }
        }
      }
      wait-for-rollout: input.wait-for-rollout
      create-timeout:   '3m'
      update-timeout:   '3m'
      delete-timeout:   '30s'
    }
    without-wait: apps.daemon-set {
      metadata: {
        name:      'unobin-it-daemon-set-no-wait'
        namespace: 'default'
        labels:    { app: 'unobin-it-daemon-set-no-wait' }
      }
      spec: {
        revision-history-limit: 0
        selector:               { match-labels: { app: 'unobin-it-daemon-set-no-wait' } }
        template: {
          metadata: { labels: { app: 'unobin-it-daemon-set-no-wait' } }
          spec: {
            container: [
              {
                name:      'app'
                image:     input.image
                resources: { requests: { memory: input.memory } }
              },
            ]
            volume: [{ name: 'scratch', empty-dir: { size-limit: '1024Ki' } }]
          }
        }
      }
      wait-for-rollout: false
      create-timeout:   '3m'
      update-timeout:   '3m'
      delete-timeout:   '30s'
    }
  }
  outputs: {
    name:            { value: resource.workload.name }
    uid:             { value: resource.workload.uid }
    replacement-uid: { value: resource.replacement.uid }
    no-wait-uid:     { value: resource.without-wait.uid }
  }
}
