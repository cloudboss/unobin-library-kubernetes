factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: {} }
  inputs:          { backing-path: { type: string }, capacity: { type: string } }
  resources: {
    update: core.persistent-volume {
      object: {
        metadata: { name: 'unobin-it-pv-update' }
        spec: {
          access-modes:             ['ReadWriteOnce']
          capacity:                 { storage: input.capacity }
          persistent-volume-source: { host-path: { path: '/unobin/update' } }
        }
      }
    }
    replacement: core.persistent-volume {
      object: {
        metadata: { name: 'unobin-it-pv-replacement' }
        spec: {
          access-modes:             ['ReadWriteOnce']
          capacity:                 { storage: '1Gi' }
          persistent-volume-source: { host-path: { path: input.backing-path } }
        }
      }
    }
  }
  outputs: {
    updated-uid:     { value: resource.update.object.metadata.uid }
    replacement-uid: { value: resource.replacement.object.metadata.uid }
  }
}
