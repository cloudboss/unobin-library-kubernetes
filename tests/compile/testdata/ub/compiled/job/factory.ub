factory: {
  imports:         { batch: 'github.com/cloudboss/unobin-library-kubernetes//api/batch/v1' }
  library-configs: { batch: {} }
  inputs: {
    api-name:            { type: string }
    completion-name:     { type: string }
    labels:              { type: map(string) }
    annotations:         { type: map(string) }
    parallelism:         { type: integer }
    backoff-limit:       { type: integer }
    wait-for-completion: { type: boolean, default: true }
  }
  resources: {
    api-job: batch.job {
      metadata: { name: input.api-name, labels: input.labels, annotations: input.annotations }
      spec: {
        parallelism:   input.parallelism
        backoff-limit: input.backoff-limit
        template: {
          metadata: { labels: { app: input.api-name } }
          spec:     { container: [{ name: 'app', image: 'busybox:1.37', command: ['true'] }] }
        }
      }
      wait-for-completion: false
      create-timeout:      '3m'
      update-timeout:      '3m'
      delete-timeout:      '30s'
    }
    completion-job: batch.job {
      metadata: {
        name:        input.completion-name
        labels:      input.labels
        annotations: input.annotations
      }
      spec: {
        parallelism:   input.parallelism
        backoff-limit: input.backoff-limit
        template: {
          metadata: { labels: { app: input.completion-name } }
          spec:     { container: [{ name: 'app', image: 'busybox:1.37', command: ['true'] }] }
        }
      }
      wait-for-completion: input.wait-for-completion
      create-timeout:      '3m'
      update-timeout:      '3m'
      delete-timeout:      '30s'
    }
  }
  outputs: {
    api-uid:        { value: resource.api-job.uid }
    completion-uid: { value: resource.completion-job.uid }
  }
}
