factory: {
  imports:         { storage: 'github.com/cloudboss/unobin-library-kubernetes//api/storage/v1' }
  library-configs: { storage: { server: 'https://127.0.0.1:1' } }
  inputs:          { name: { type: string }, policy: { type: string } }
  resources: {
    class: storage.storage-class {
      metadata:       { name: input.name }
      provisioner:    'example/provisioner'
      reclaim-policy: input.policy
    }
  }
}
