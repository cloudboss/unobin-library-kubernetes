factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: { server: input.server } }
  inputs: {
    server: { type: string }
    name:   { type: string }
    choice: { type: string }
  }
  locals: {
    quota-specs: {
      valid:            { hard: { pods: '2' } }
      missing-operator: { scope-selector: { match-expressions: [{ scope-name: 'PriorityClass' }] } }
    }
  }
  data-sources: {
    live: core.config-map {
      @depends-on: [resource.seed]
      metadata:    { name: 'quota-seed' }
    }
  }
  resources: {
    seed: core.config-map {
      object: {
        metadata: { name: 'quota-seed' }
        data:     { choice: input.choice }
      }
    }
    subject: core.resource-quota {
      metadata: { name: input.name }
      spec:     @core.lookup(local.quota-specs, data-source.live.data['choice'])
    }
  }
}
