factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: { server: input.server } }
  inputs: {
    server:            { type: string }
    name:              { type: string }
    operator:          { type: string }
    resolved-operator: { type: string }
  }
  locals: {
    expressions: { worker: { scope-name: 'BestEffort', operator: 'Exists' } }
  }
  data-sources: {
    live: core.config-map-info {
      @depends-on: [resource.seed]
      metadata:    { name: 'quota-seed' }
    }
  }
  resources: {
    seed: core.config-map {
      object: {
        metadata: { name: 'quota-seed' }
        data:     { hard: '2', class: 'worker', operator: input.resolved-operator }
      }
    }
    subject: core.resource-quota {
      metadata: { name: input.name }
      spec: {
        hard: { pods: data-source.live.data['hard'] }
        scope-selector: {
          match-expressions: [
            {
              scope-name: 'PriorityClass'
              operator:   input.operator
              values:     [data-source.live.data['class']]
            },
            {
              scope-name: 'PriorityClass'
              operator:   data-source.live.data['operator']
              values:     ['worker']
            },
            @core.lookup(local.expressions, data-source.live.data['class']),
          ]
        }
      }
    }
  }
}
