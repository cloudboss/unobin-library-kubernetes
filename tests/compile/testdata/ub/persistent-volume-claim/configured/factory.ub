factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: {} }
  inputs:          { name: { type: string }, mode: { type: string } }
  resources: {
    claim: core.persistent-volume-claim {
      object: {
        metadata: { name: input.name }
        spec: {
          access-modes: ['ReadWriteOnce']
          resources:    { requests: { storage: '1Gi' } }
          volume-mode:  input.mode
        }
      }
      wait-until-bound: false
    }
  }
}
