factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: {} }
  data-sources: {
    claim: core.persistent-volume-claim {
      metadata: { name: 'lookup' }
    }
  }
  outputs: {
    status:      { value: data-source.claim.status }
    id:          { value: data-source.claim.id }
    data-source: { value: data-source.claim.spec?.data-source }
  }
}
