factory: {
  imports: {
    kubernetes: 'github.com/cloudboss/unobin-library-kubernetes//tests/compile/probe'
    tokens: 'github.com/cloudboss/unobin-library-kubernetes//tests/compile/token'
  }
  inputs: {
    kubernetes-config: {
      type: library-config('github.com/cloudboss/unobin-library-kubernetes//config')
      default: { server: 'https://cluster.example' }
    }
  }
  library-configs: {
    kubernetes: {
      server: input.kubernetes-config.server
      token: action.get-token.token
    }
  }
  actions: {
    get-token: tokens.issue { value: 'test-token' }
  }
  data-sources: {
    connection: kubernetes.configuration { expected-token: 'test-token' }
  }
  outputs: {
    server: { value: data-source.connection.server }
    token-matches: { value: data-source.connection.token-matches }
  }
}
