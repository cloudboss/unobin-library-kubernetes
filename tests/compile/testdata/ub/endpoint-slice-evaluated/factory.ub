factory: {
  imports: {
    discovery: 'github.com/cloudboss/unobin-library-kubernetes//api/discovery/v1'
    tokens:    'github.com/cloudboss/unobin-library-kubernetes//tests/compile/token'
  }
  library-configs: {
    discovery: {
      server:          input.server
      kubeconfig:      input.kubeconfig
      current-context: input.context
      token:           input.token
    }
  }
  inputs: {
    server:                    { type: optional(string) }
    kubeconfig:                { type: optional(string) }
    context:                   { type: optional(string) }
    token:                     { type: optional(string) }
    seed:                      { type: string, default: 'IPv4' }
    address-type:              { type: string, default: 'IPv4' }
    defer-type:                { type: boolean, default: false }
    defer-ports:               { type: boolean, default: false }
    defer-endpoints:           { type: boolean, default: false }
    port-kind:                 { type: string, default: 'valid' }
    endpoint-kind:             { type: string, default: 'valid' }
    name:                      { type: optional(string), default: 'example' }
    namespace:                 { type: optional(string) }
    generated:                 { type: optional(string) }
    label:                     { type: string, default: 'valid' }
    label-key:                 { type: string, default: 'test' }
    annotation-key:            { type: string, default: 'test' }
    ignore:                    { type: string, default: '^ignored' }
    hostname:                  { type: optional(string) }
    port-count:                { type: integer, default: 1 }
    endpoint-count:            { type: integer, default: 1 }
    port:                      { type: string, default: '80' }
    protocol:                  { type: optional(string) }
    use-pending-port:          { type: boolean, default: false }
    use-pending-comprehension: { type: boolean, default: false }
    use-pending-hostname:      { type: boolean, default: false }
    pending-zone:              { type: boolean, default: false }
  }
  locals: {
    port-variants: {
      valid:        [{ port: input.port, app-protocol: '' }]
      missing-port: [{ app-protocol: '' }]
      missing-app:  [{ port: input.port }]
      null-app:     [{ port: input.port, app-protocol: null }]
    }
    endpoint-variants: {
      valid:             [{ addresses: ['192.0.2.1'] }]
      missing-name:      [{ addresses: ['192.0.2.1'], target-ref: { namespace: 'default' } }]
      null-name:         [{ addresses: ['192.0.2.1'], target-ref: { name: null } }]
      missing-addresses: [{}]
    }
    known-endpoints: if input.endpoint-count == 1
      then [
        {
          addresses: ['192.0.2.1']
          hostname:  if input.use-pending-hostname then action.seed.token else input.hostname
          zone:      if input.pending-zone then action.seed.token else null
        },
      ]
      else [
        for i in @core.range(input.endpoint-count) :
        {
          addresses: ['192.0.2.1']
          hostname:  input.hostname
          zone:      input.hostname
        }
      ]
    usual-port: { port: input.port, protocol: input.protocol, app-protocol: '' }
    known-ports: if input.use-pending-port
      then [
        { port: action.seed.token, protocol: input.protocol, app-protocol: '' },
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
        local.usual-port,
      ]
      else if input.use-pending-comprehension
        then [
          for i in @core.range(input.port-count) :
          { port: action.seed.token, protocol: input.protocol, app-protocol: '' }
        ]
        else [ for i in @core.range(input.port-count) : local.usual-port ]
  }
  actions: {
    seed: tokens.issue {
      value: input.seed
    }
  }
  resources: {
    slice: discovery.endpoint-slice {
      metadata: {
        name:          input.name
        generate-name: input.generated
        namespace:     input.namespace
        labels:        { for key in [input.label-key] : key => input.label }
        annotations:   { for key in [input.annotation-key] : key => 'test' }
      }
      address-type: if input.defer-type then action.seed.token else input.address-type
      endpoints: if input.defer-endpoints
        then @core.lookup(local.endpoint-variants, action.seed.token)
        else if input.endpoint-kind != 'valid'
          then @core.lookup(local.endpoint-variants, input.endpoint-kind)
          else local.known-endpoints
      ports: if input.defer-ports
        then @core.lookup(local.port-variants, action.seed.token)
        else if input.port-kind != 'valid'
          then @core.lookup(local.port-variants, input.port-kind)
          else local.known-ports
      ignore-annotations: [input.ignore]
      ignore-labels:      [input.ignore]
    }
  }
}
