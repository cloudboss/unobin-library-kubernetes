factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: {} }
  data-sources: {
    endpoint: core.namespace {
      metadata: {
        name:        'dotted.name'
        annotations: { 'EXAMPLE.COM/Key': 'arbitrary value', 'İ.COM/Key': null }
        labels:      { app: '', nullable: null }
      }
    }
  }
  outputs: {
    metadata: { value: data-source.endpoint.metadata }
    spec:     { value: data-source.endpoint.spec }
  }
}
