factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: {} }
  data-sources: {
    empty-name: core.service-account {
      metadata: { name: '' }
    }
    bad-name: core.service-account {
      metadata: { name: 'Bad_Name' }
    }
    long-name: core.service-account {
      metadata: {
        name: '''\-
          aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.bbbbbbbbbbbbbbbbbbbbb
          bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.cccccccccccccccccccccccccccccccccccccccccc
          ccccccccccccccccccccc.dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
          '''
      }
    }
    label-key: core.service-account {
      metadata: { labels: { 'EXAMPLE.COM/Key': '' } }
    }
    label-suffix: core.service-account {
      metadata: { labels: { kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk: '' } }
    }
    label-value: core.service-account {
      metadata: { labels: { app: 'bad value' } }
    }
    long-value: core.service-account {
      metadata: {
        labels: { app: 'kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk' }
      }
    }
    annotation-key: core.service-account {
      metadata: { annotations: { 'bad key': '' } }
    }
    annotation-suffix: core.service-account {
      metadata: {
        annotations: { kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk: '' }
      }
    }
  }
}
