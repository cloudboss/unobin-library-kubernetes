factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: {} }
  data-sources: {
    lookup: core.service-account {
      metadata: { name: 'lookup' }
    }
  }
  outputs: {
    generate-name: { value: data-source.lookup.metadata.generate-name }
    id:            { value: data-source.lookup.id }
    token-payload: { value: data-source.lookup.secrets[0].data }
  }
}
