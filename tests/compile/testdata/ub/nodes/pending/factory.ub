factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: { server: input.server } }
  inputs: {
    server:      { type: string }
    mode:        { type: string }
    known-key:   { type: string }
    known-value: { type: string }
  }
  resources: {
    seed: core.config-map {
      object: { metadata: { name: 'node-selector-seed', namespace: 'default' } }
    }
  }
  data-sources: {
    lookup: core.nodes {
      metadata: {
        labels: if input.mode == 'comprehension'
          then { for k in [input.known-key] : k => resource.seed.object.metadata.uid }
          else if input.mode == 'pending-key'
            then { for k in ['include'] : resource.seed.object.metadata.uid => k }
            else if input.mode == 'literal-key'
              then { 'UPPER.example/Name': resource.seed.object.metadata.uid }
              else { app: resource.seed.object.metadata.uid, sibling: input.known-value }
      }
    }
  }
  outputs: { nodes: { value: data-source.lookup.nodes } }
}
