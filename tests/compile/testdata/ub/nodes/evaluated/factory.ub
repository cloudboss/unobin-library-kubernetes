factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: { server: input.server, namespace: 'ignored' } }
  inputs: {
    server:         { type: string }
    selector-key:   { type: string }
    selector-value: { type: string }
  }
  data-sources: {
    lookup: core.nodes {
      metadata: { labels: { for k in [input.selector-key] : k => input.selector-value } }
    }
  }
  outputs: { nodes: { value: data-source.lookup.nodes } }
}
