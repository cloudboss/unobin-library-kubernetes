factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: {} }
  data-sources: {
    lookup: core.nodes {}
  }
  outputs: {
    leaked-names: { value: [ for n in data-source.lookup.nodes ?? [] : n.metadata.generate-name ] }
  }
}
