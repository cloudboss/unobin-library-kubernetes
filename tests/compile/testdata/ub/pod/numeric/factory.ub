factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: {} }

  resources: {
    subject: core.pod {
      metadata: { name: 'pod' }
      spec:     { container: [{ name: 'a', readiness-probe: { failure-threshold: 0 } }] }
    }
  }
}
