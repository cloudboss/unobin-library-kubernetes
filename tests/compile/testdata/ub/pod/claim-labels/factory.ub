factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: {} }

  resources: {
    subject: core.pod {
      metadata: { name: 'pod' }
      spec: {
        volume: [
          {
            ephemeral: {
              volume-claim-template: {
                metadata: { labels: { 'bad key': 'ok' } }
                spec:     { access-modes: ['ReadWriteOnce'], resources: {} }
              }
            }
          },
        ]
      }
    }
  }
}
