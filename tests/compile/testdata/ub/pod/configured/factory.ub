factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: { server: input.server, insecure-skip-tls-verify: true } }
  inputs: {
    server:   { type: string, default: 'https://unreachable.invalid' }
    metadata: { type: opaque }
    spec:     { type: opaque }
  }
  resources: {
    subject: core.pod {
      metadata: @core.lookup({ subject: input.metadata }, 'subject')
      spec:     @core.lookup({ subject: input.spec }, 'subject')
    }
  }
}
