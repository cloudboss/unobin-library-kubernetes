factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: {} }

  resources: {
    subject: core.pod {
      metadata: { name: 'pod' }
      spec:     { init-container: [{ name: 'i', liveness-probe: { grpc: { port: 65536 } } }] }
    }
  }
}
