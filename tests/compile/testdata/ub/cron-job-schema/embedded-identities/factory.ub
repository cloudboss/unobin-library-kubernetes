factory: {
  imports:         { batch: 'github.com/cloudboss/unobin-library-kubernetes//api/batch/v1' }
  library-configs: { batch: {} }
  resources: {
    empty: batch.cron-job {
      metadata: { name: 'example-empty' }
      spec: {
        schedule:     '* * * * *'
        job-template: { metadata: {}, spec: { template: { metadata: {} } } }
      }
    }
    named: batch.cron-job {
      metadata: { name: 'example-named' }
      spec: {
        schedule: '* * * * *'
        job-template: {
          metadata: { name: 'template-name' }
          spec:     { template: { metadata: { name: 'template-name' } } }
        }
      }
    }
    prefixed: batch.cron-job {
      metadata: { name: 'example-prefixed' }
      spec: {
        schedule: '* * * * *'
        job-template: {
          metadata: { generate-name: 'template-prefix-' }
          spec:     { template: { metadata: { generate-name: 'template-prefix-' } } }
        }
      }
    }
  }
}
