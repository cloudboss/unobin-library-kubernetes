factory: {
  imports:         { node: 'github.com/cloudboss/unobin-library-kubernetes//api/node/v1' }
  library-configs: { node: {} }
  resources: {
    missing-metadata: node.runtime-class {
      handler: 'r'
    }
    null-metadata: node.runtime-class {
      metadata: null
      handler:  'r'
    }
    wrong-metadata: node.runtime-class {
      metadata: [{ name: 'r' }]
      handler:  'r'
    }
    missing-handler: node.runtime-class {
      metadata: { name: 'r' }
    }
    null-handler: node.runtime-class {
      metadata: { name: 'r' }
      handler:  null
    }
    wrong-handler: node.runtime-class {
      metadata: { name: 'r' }
      handler:  1
    }
    unsupported: node.runtime-class {
      metadata:   { name: 'r', namespace: 'default' }
      handler:    'r'
      overhead:   {}
      scheduling: {}
    }
    null-label-value: node.runtime-class {
      metadata: { name: 'r', labels: { k: null } }
      handler:  'r'
    }
    null-annotation-value: node.runtime-class {
      metadata: { name: 'r', annotations: { k: null } }
      handler:  'r'
    }
    null-label-filter: node.runtime-class {
      metadata:      { name: 'r' }
      handler:       'r'
      ignore-labels: [null]
    }
    null-annotation-filter: node.runtime-class {
      metadata:           { name: 'r' }
      handler:            'r'
      ignore-annotations: [null]
    }
  }
}
