factory: {
  imports:         { hpa: 'github.com/cloudboss/unobin-library-kubernetes//api/autoscaling/v2' }
  library-configs: { hpa: {} }
  resources: {
    hpa: hpa.horizontal-pod-autoscaler {
      object: {
        metadata: { generate-name: 'bad.prefix-' }
        spec: {
          max-replicas:     -1
          min-replicas:     10
          scale-target-ref: { kind: 'arbitrary', name: '' }
          metric:           [{ type: 'Resource' }]
        }
      }
    }
  }
}
