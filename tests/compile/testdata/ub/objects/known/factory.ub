factory: {
  imports:         { dynamic: 'github.com/cloudboss/unobin-library-kubernetes//dynamic' }
  library-configs: { dynamic: { server: input.server, namespace: 'configured' } }
  inputs: {
    server:      { type: string }
    api-version: { type: string }
    kind:        { type: string }
    limit:       { type: optional(number) }
  }
  data-sources: {
    endpoint: dynamic.objects {
      api-version: input.api-version
      kind:        input.kind
      limit:       input.limit
    }
  }
  outputs: { observed: { value: @core.to-json(data-source.endpoint.objects) } }
}
