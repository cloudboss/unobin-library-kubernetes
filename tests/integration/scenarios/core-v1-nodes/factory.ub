factory: {
  description:     'Lists Nodes with a stable selector for saved plans.'
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: {} }
  inputs:          { selector: { type: string } }
  data-sources: {
    selected: core.nodes {
      metadata: { labels: { 'unobin.cloudboss.com/nodes-integration-absent': input.selector } }
    }
  }
  outputs: { nodes: { value: data-source.selected.nodes } }
}
