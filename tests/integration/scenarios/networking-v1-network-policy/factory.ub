factory: {
  description: 'Creates traffic rules, clears restrictions, and replaces a named NetworkPolicy.'
  imports:     { networking: 'github.com/cloudboss/unobin-library-kubernetes//api/networking/v1' }
  library-configs: { networking: {} }
  inputs: {
    spec: {
      type: object(
        {
          pod-selector: object({ match-labels: optional(map(string)) })
          policy-types: list(string)
          ingress: optional(
            list(
              object(
                {
                  ports: optional(
                    list(
                      object(
                        {
                          port:     optional(string)
                          protocol: optional(string)
                          end-port: optional(integer)
                        },
                      ),
                    ),
                  )
                  from: optional(
                    list(
                      object(
                        {
                          namespace-selector: optional(
                            object({ match-labels: optional(map(string)) }),
                          )
                          pod-selector: optional(object({ match-labels: optional(map(string)) }))
                        },
                      ),
                    ),
                  )
                },
              ),
            ),
          )
          egress: optional(
            list(
              object(
                {
                  ports: optional(
                    list(
                      object(
                        {
                          port:     optional(string)
                          protocol: optional(string)
                          end-port: optional(integer)
                        },
                      ),
                    ),
                  )
                  to: optional(
                    list(
                      object(
                        {
                          ip-block: optional(
                            object({ cidr: optional(string), except: optional(list(string)) }),
                          )
                        },
                      ),
                    ),
                  )
                },
              ),
            ),
          )
        },
      )
    }
    replacement-name: { type: string }
  }
  resources: {
    policy: networking.network-policy {
      metadata: {
        generate-name: 'unobin-it-policy-'
        labels: {
          'test.unobin.cloudboss.io/scenario': 'networking-v1-network-policy'
          'test.unobin.cloudboss.io/role':     'stable'
        }
      }
      spec: input.spec
    }
    replaced: networking.network-policy {
      metadata: {
        name: input.replacement-name
        labels: {
          'test.unobin.cloudboss.io/scenario': 'networking-v1-network-policy'
          'test.unobin.cloudboss.io/role':     'replaced'
        }
      }
      spec: { pod-selector: {}, policy-types: ['Ingress'] }
    }
  }
  outputs: {
    name: { value: resource.policy.name }
    uid:  { value: resource.policy.uid }
    spec: { value: resource.policy.spec }
  }
}
