stack: {
  factory: {
    inputs: {
      cron-job-stage:          'initial'
      cron-job-ttl:            '300'
      cron-job-suspend:        false
      cron-job-image:          'busybox:1.37'
      job-api-name:            'unobin-it-job-api'
      job-completion-name:     'unobin-it-job-completion'
      job-labels:              { app: 'job-api', stage: 'initial' }
      job-annotations:         { stage: 'initial' }
      job-parallelism:         1
      job-backoff-limit:       6
      job-wait-for-completion: true
    }
  }
  state: local {
    path: '.unobin/state'
  }
  encryption: noop {}
}
