factory: {
  imports:         { batch: 'github.com/cloudboss/unobin-library-kubernetes//api/batch/v1' }
  library-configs: { batch: {} }
  inputs:          { name: { type: string } }
  data-sources: {
    lookup: batch.job {
      metadata: { name: input.name }
    }
  }
  outputs: {
    lookup: {
      value: {
        metadata: data-source.lookup.metadata
        spec:     data-source.lookup.spec
        status:   data-source.lookup.status
      }
    }
  }
}
