factory: {
  imports:         { discovery: 'github.com/cloudboss/unobin-library-kubernetes//api/discovery/v1' }
  library-configs: { discovery: {} }
  inputs: {
    address-type: { type: string }
    address:      { type: string }
    port:         { type: string }
    node:         { type: string }
    version:      { type: string }
  }
  resources: {
    stable: discovery.endpoint-slice {
      metadata: {
        name:        'unobin-it-endpoint-slice-stable'
        labels:      { 'test.unobin.cloudboss.io/version': input.version }
        annotations: { 'test.unobin.cloudboss.io/version': input.version }
      }
      address-type: 'IPv4'
      endpoints:    [{ addresses: ['192.0.2.1', '192.0.2.2'], node-name: input.node }]
      ports:        [{ name: 'web', port: input.port, app-protocol: 'http', protocol: 'UDP' }]
    }
    replaced: discovery.endpoint-slice {
      metadata:     { name: 'unobin-it-endpoint-slice-replaced' }
      address-type: input.address-type
      endpoints:    [{ addresses: [input.address], conditions: { ready: true } }]
      ports:        [{ port: '81', app-protocol: 'http', protocol: 'SCTP' }]
    }
  }
  data-sources: {
    live-slice: discovery.endpoint-slice {
      metadata: {
        name:        resource.stable.name
        namespace:   resource.stable.namespace
        annotations: { ignored: 'configured' }
        labels:      { ignored: 'configured' }
      }
    }
    missing-slice: discovery.endpoint-slice {
      metadata: {
        name:          'unobin-it-endpoint-slice-absent'
        generate-name: 'missing-'
        labels:        { expectation: 'absent', omitted: null }
      }
    }
  }
  outputs: {
    live-metadata:        { value: data-source.live-slice.metadata }
    live-address-type:    { value: data-source.live-slice.address-type }
    live-endpoints:       { value: data-source.live-slice.endpoints }
    live-ports:           { value: data-source.live-slice.ports }
    missing-metadata:     { value: data-source.missing-slice.metadata }
    missing-address-type: { value: data-source.missing-slice.address-type }
    missing-endpoints:    { value: data-source.missing-slice.endpoints }
    missing-ports:        { value: data-source.missing-slice.ports }
    stable-uid:           { value: resource.stable.uid }
    replaced-uid:         { value: resource.replaced.uid }
  }
}
