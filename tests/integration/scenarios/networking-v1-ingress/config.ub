stack: {
  factory: {
    inputs: {
      replacement-name: 'unobin-it-ingress-first'
      spec: {
        default-backend: { service: { name: 'app', port: { number: 80 } } }
        rule: [
          {
            host: 'b.example.com'
            http: {
              path: [
                { path: '/second', backend: { service: { name: 'app', port: { name: 'http' } } } },
                {
                  path:      '/first'
                  path-type: 'Prefix'
                  backend:   { service: { name: 'app', port: { number: 80 } } }
                },
                { path: '/second', backend: { service: { name: 'app', port: { name: 'http' } } } },
              ]
            }
          },
          {
            host: 'a.example.com'
            http: {
              path: [
                { path: '/', backend: { service: { name: 'app', port: { number: 80 } } } },
              ]
            }
          },
        ]
        tls: [
          { hosts: ['b.example.com', 'a.example.com', 'b.example.com'], secret-name: 'first' },
          { hosts: ['a.example.com'], secret-name: 'second' },
        ]
      }
    }
  }
  state: local {
    path: '.unobin/state'
  }
  encryption: noop {}
}
