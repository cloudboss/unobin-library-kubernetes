stack: {
  factory: {
    inputs: {
      daemon-set-image:              'registry.k8s.io/pause:3.9'
      daemon-set-epoch:              'first'
      daemon-set-memory:             '1024Ki'
      daemon-set-wait-for-rollout:   false
      deployment-name:               'unobin-it-deployment'
      deployment-image:              'registry.k8s.io/pause:3.9'
      deployment-replicas:           '1'
      deployment-wait-for-rollout:   false
      stateful-set-name:             'unobin-it-stateful-set'
      stateful-set-image:            'registry.k8s.io/pause:3.9'
      stateful-set-replicas:         '2'
      stateful-set-wait-for-rollout: false
    }
  }
  state: local {
    path: '.unobin/state'
  }
  encryption: noop {}
}
