factory: {
  imports: {
    rbac-cluster-role: 'github.com/cloudboss/unobin-library-kubernetes//api/rbac/v1'
    rbac:              'github.com/cloudboss/unobin-library-kubernetes//api/rbac/v1'
  }
  library-configs: {
    rbac-cluster-role: { namespace: 'unused' }
    rbac:              {}
  }
  inputs: {
    temporary-role-binding-lookups: { type: map(boolean), default: {} }
    cluster-role-verb:              { type: string }
    cluster-role-resource-name:     { type: string }
    cluster-role-binding-user:      { type: string }
    cluster-role-binding-account:   { type: string }
    role-verbs:                     { type: list(string) }
    role-resource-names:            { type: list(string) }
    role-binding-user:              { type: string }
    role-binding-account:           { type: string }
  }
  resources: {
    cluster-role-reader: rbac-cluster-role.cluster-role {
      metadata: {
        generate-name: 'unobin-it-cluster-reader-'
        labels: {
          'test.unobin.cloudboss.io/scenario':  'rbac-v1-cluster-role'
          'test.unobin.cloudboss.io/aggregate': 'reader'
        }
      }
      rule: [
        {
          verbs:          ['get', input.cluster-role-verb, 'get']
          api-groups:     ['']
          resources:      ['pods']
          resource-names: [input.cluster-role-resource-name]
        },
      ]
    }
    cluster-role-aggregate: rbac-cluster-role.cluster-role {
      metadata: {
        generate-name: 'unobin-it-cluster-aggregate-'
        labels:        { 'test.unobin.cloudboss.io/scenario': 'rbac-v1-cluster-role' }
      }
      aggregation-rule: {
        cluster-role-selectors: [
          {
            match-labels: { 'test.unobin.cloudboss.io/aggregate': 'reader' }
            match-expressions: [
              { key: 'test.unobin.cloudboss.io/aggregate', operator: 'In', values: ['reader'] },
            ]
          },
        ]
      }
    }
    cluster-role-binding-binding: rbac.cluster-role-binding {
      metadata: {
        generate-name: 'unobin-it-binding-'
        labels:        { 'test.unobin.cloudboss.io/scenario': 'rbac-v1-cluster-role-binding' }
      }
      role-ref: { api-group: 'rbac.authorization.k8s.io', kind: 'ClusterRole', name: 'view' }
      subject: [
        { kind: 'User', name: input.cluster-role-binding-user, namespace: '' },
        { kind: 'Group', name: 'readers', api-group: '', namespace: '' },
        { kind: 'ServiceAccount', name: input.cluster-role-binding-account },
        { kind: 'ServiceAccount', name: input.cluster-role-binding-account },
      ]
    }
    role-reader: rbac.role {
      metadata: {
        generate-name: 'unobin-it-role-'
        labels:        { 'test.unobin.cloudboss.io/scenario': 'rbac-v1-role' }
      }
      rule: [
        {
          api-groups:     ['']
          resources:      ['pods']
          verbs:          input.role-verbs
          resource-names: input.role-resource-names
        },
      ]
    }
    role-binding-binding: rbac.role-binding {
      metadata: {
        generate-name: 'unobin-it-binding-'
        labels:        { 'test.unobin.cloudboss.io/scenario': 'rbac-v1-role-binding' }
      }
      role-ref: { api-group: 'rbac.authorization.k8s.io', kind: 'ClusterRole', name: 'view' }
      subject: [
        { kind: 'User', name: input.role-binding-user, namespace: '' },
        { kind: 'Group', name: 'readers', api-group: '', namespace: '' },
        { kind: 'ServiceAccount', name: input.role-binding-account },
        { kind: 'ServiceAccount', name: input.role-binding-account },
      ]
    }
  }
  data-sources: {
    cluster-role-reader: rbac-cluster-role.cluster-role {
      metadata: { name: resource.cluster-role-reader.name }
    }
    cluster-role-aggregate: rbac-cluster-role.cluster-role {
      metadata: { name: resource.cluster-role-aggregate.name }
    }
    cluster-role-missing: rbac-cluster-role.cluster-role {
      metadata: { name: 'unobin-it-cluster-role-lookup-absent' }
    }
    role-binding-reader: rbac.role-binding {
      metadata: {
        name:      resource.role-binding-binding.name
        namespace: resource.role-binding-binding.namespace
      }
    }
    role-binding-temporary: rbac.role-binding {
      @for-each: input.temporary-role-binding-lookups
      metadata: {
        name:      resource.role-binding-binding.name
        namespace: resource.role-binding-binding.namespace
      }
    }
    role-binding-missing: rbac.role-binding {
      metadata: { name: 'unobin-it-role-binding-lookup-absent' }
    }
    role-reader: rbac.role {
      metadata: {
        name:      resource.role-reader.name
        namespace: resource.role-reader.namespace
      }
    }
    role-missing: rbac.role {
      metadata: { name: 'unobin-it-role-lookup-absent' }
    }
  }
  outputs: {
    cluster-role-lookup: {
      value: {
        direct: {
          metadata:         data-source.cluster-role-reader.metadata
          rules:            data-source.cluster-role-reader.rules
          aggregation-rule: data-source.cluster-role-reader.aggregation-rule
        }
        aggregate: {
          metadata:         data-source.cluster-role-aggregate.metadata
          rules:            data-source.cluster-role-aggregate.rules
          aggregation-rule: data-source.cluster-role-aggregate.aggregation-rule
        }
        missing: {
          metadata:         data-source.cluster-role-missing.metadata
          rules:            data-source.cluster-role-missing.rules
          aggregation-rule: data-source.cluster-role-missing.aggregation-rule
        }
      }
    }
    role-binding-lookup: {
      value: {
        metadata:         data-source.role-binding-reader.metadata
        role-ref:         data-source.role-binding-reader.role-ref
        subjects:         data-source.role-binding-reader.subjects
        missing-metadata: data-source.role-binding-missing.metadata
        missing-role-ref: data-source.role-binding-missing.role-ref
        missing-subjects: data-source.role-binding-missing.subjects
        temporary: if @core.length(input.temporary-role-binding-lookups) == 0
          then {}
          else {
            for key, enabled in input.temporary-role-binding-lookups :
            key => {
              metadata: data-source.role-binding-temporary[key].metadata
              role-ref: data-source.role-binding-temporary[key].role-ref
              subjects: data-source.role-binding-temporary[key].subjects
            }
          }
      }
    }
    role-lookup: {
      value: {
        metadata:         data-source.role-reader.metadata
        rules:            data-source.role-reader.rules
        missing-metadata: data-source.role-missing.metadata
        missing-rules:    data-source.role-missing.rules
      }
    }

    cluster-role: {
      value: {
        name:           resource.cluster-role-reader.name
        uid:            resource.cluster-role-reader.uid
        rule:           resource.cluster-role-reader.rule
        aggregate-name: resource.cluster-role-aggregate.name
      }
    }
    cluster-role-binding: {
      value: {
        name:     resource.cluster-role-binding-binding.name
        uid:      resource.cluster-role-binding-binding.uid
        role-ref: resource.cluster-role-binding-binding.role-ref
        subject:  resource.cluster-role-binding-binding.subject
      }
    }
    role: {
      value: {
        name:      resource.role-reader.name
        namespace: resource.role-reader.namespace
        uid:       resource.role-reader.uid
        rule:      resource.role-reader.rule
      }
    }
    role-binding: {
      value: {
        name:      resource.role-binding-binding.name
        namespace: resource.role-binding-binding.namespace
        uid:       resource.role-binding-binding.uid
        role-ref:  resource.role-binding-binding.role-ref
        subject:   resource.role-binding-binding.subject
      }
    }
  }
}
