factory: {
  description: 'Creates a generated immutable ConfigMap and replaces it when its content changes.'

  imports: {
    kubernetes: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1'
  }

  library-configs: { kubernetes: {} }

  inputs: {
    value: { type: string }
    binary-value: { type: string }
    immutable: { type: boolean }
  }

  resources: {
    settings: kubernetes.config-map {
      object: {
        metadata: {
          generate-name: 'unobin-it-config-map-'
          labels: { 'test.unobin.cloudboss.io/scenario': 'core-v1-config-map' }
        }
        data: { value: input.value }
        binary-data: { bytes: input.binary-value empty: '' }
        immutable: input.immutable
      }
    }
  }

  outputs: {
    name: { value: resource.settings.object.metadata.name }
    namespace: { value: resource.settings.object.metadata.namespace }
    uid: { value: resource.settings.object.metadata.uid }
    data: { value: resource.settings.object.data }
    binary-data: { value: resource.settings.object.binary-data }
    immutable: { value: resource.settings.object.immutable }
  }
}
