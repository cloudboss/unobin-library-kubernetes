factory: {
  imports: {
    dynamic:               'github.com/cloudboss/unobin-library-kubernetes//dynamic'
    core:                  'github.com/cloudboss/unobin-library-kubernetes//api/core/v1'
    core-namespace-lookup: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1'
  }
  library-configs: {
    dynamic:               {}
    core:                  {}
    core-namespace-lookup: { namespace: 'ignored' }
  }
  inputs: {
    config-map-value:               { type: string }
    config-map-binary-value:        { type: string }
    config-map-immutable:           { type: boolean }
    config-map-lookup-value:        { type: string }
    config-map-lookup-binary-value: { type: string }
    namespace-value:                { type: string }
    namespace-lookup-value:         { type: string }
    node-taint-value:               { type: string }
    nodes-selector:                 { type: string }
    persistent-volume-backing-path: { type: string }
    persistent-volume-capacity:     { type: string }
    persistent-volume-lookup-value: { type: string }
    temporary-pv-lookups:           { type: map(boolean) }
    persistent-volume-claim-value:  { type: string }
    pod-deadline:                   { type: integer }
    pod-epoch:                      { type: string }
    pod-image:                      { type: string }
    pod-phase:                      { type: optional(list(string)), default: null }
    temporary-secret-lookups:       { type: map(boolean), default: { temporary: true } }
    secret-value:                   { type: string }
    secret-binary-value:            { type: string }
    secret-immutable:               { type: boolean }
    secret-data-values:             { type: map(string) }
    secret-data-force:              { type: boolean }
    temporary-secret-data:          { type: map(boolean) }
    service-value:                  { type: string }
    service-target-port:            { type: string }
    service-replacement-prefix:     { type: string }
    service-account-value:          { type: string }
    service-account-automount:      { type: boolean }
    service-lookup-value:           { type: string }
  }
  resources: {
    config-map-settings: core.config-map {
      object: {
        metadata: {
          generate-name: 'unobin-it-config-map-'
          labels:        { 'test.unobin.cloudboss.io/scenario': 'core-v1-config-map' }
        }
        data:        { value: input.config-map-value }
        binary-data: { bytes: input.config-map-binary-value, empty: '' }
        immutable:   input.config-map-immutable
      }
    }
    config-map-lookup-settings: core.config-map {
      object: {
        metadata:    { name: 'unobin-it-config-map-info', namespace: 'default' }
        data:        { value: input.config-map-lookup-value, unicode: '雪', empty-text: '' }
        binary-data: { bytes: input.config-map-lookup-binary-value, empty-bytes: '' }
      }
    }
    namespace-project: core.namespace {
      object: {
        metadata: {
          generate-name: 'unobin-it-namespace-'
          labels: {
            'test.unobin.cloudboss.io/scenario': 'core-v1-namespace'
            value:                               input.namespace-value
          }
          annotations: { 'example.com/value': input.namespace-value }
        }
      }
      wait-for-default-service-account: true
      delete-timeout:                   '30s'
    }
    endpoints-lookup-fixture: dynamic.object {
      manifest: '''|-
        apiVersion: v1
        kind: Endpoints
        metadata:
          name: unobin-it-core-v1-endpoints-lookup
          namespace: default
          labels:
            example.com/fixture: endpoints
          annotations:
            example.com/fixture: standalone
        subsets:
        - addresses:
          - ip: 192.0.2.12
            hostname: primary
            nodeName: worker-a
          notReadyAddresses:
          - ip: 192.0.2.11
          ports:
          - { name: dns, port: 53, protocol: UDP }
          - { name: api, port: 8080, protocol: TCP }
        - addresses:
          - ip: "2001:db8::1"
          ports:
          - { name: alternate, port: 9090 }
        '''
    }
    node-taint-fixture: dynamic.object {
      manifest: '''|-
        apiVersion: v1
        kind: Node
        metadata:
          name: unobin-it-core-v1-node-taint
          labels:
            test.unobin.cloudboss.io/scenario: core-v1-node-taint
        spec:
          unschedulable: true
        '''
    }
    node-taint: core.node-taint {
      object: {
        metadata: { name: resource.node-taint-fixture.name }
        spec: {
          taints: [
            { key: 'test.unobin.cloudboss.io/second', effect: 'PreferNoSchedule', value: '' },
            {
              key:    'test.unobin.cloudboss.io/first'
              effect: 'NoExecute'
              value:  input.node-taint-value
            },
          ]
        }
      }
      field-manager: 'unobin-node-taint-scenario'
      force:         true
    }
    persistent-volume-update: core.persistent-volume {
      object: {
        metadata: {
          name:        'unobin-it-pv-update'
          labels:      { 'example.com/fixture': 'persistent-volume' }
          annotations: { 'example.com/fixture': 'read by the group scenario' }
        }
        spec: {
          access-modes:             ['ReadWriteOnce']
          storage-class-name:       'unobin-it-static-volume'
          capacity:                 { storage: input.persistent-volume-capacity }
          persistent-volume-source: { host-path: { path: '/unobin/update' } }
        }
      }
    }
    persistent-volume-replacement: core.persistent-volume {
      object: {
        metadata: { name: 'unobin-it-pv-replacement' }
        spec: {
          access-modes:             ['ReadWriteOnce']
          storage-class-name:       'unobin-it-static-volume'
          capacity:                 { storage: '1Gi' }
          persistent-volume-source: { host-path: { path: input.persistent-volume-backing-path } }
        }
      }
    }
    persistent-volume-lookup-fixture: core.persistent-volume {
      object: {
        metadata: {
          name:        'unobin-it-pv-lookup-fixture'
          labels:      { 'example.com/fixture': 'persistent-volume-lookup' }
          annotations: { 'example.com/fixture': 'retained after lookup removal' }
        }
        spec: {
          access-modes:                     ['ReadWriteOnce']
          capacity:                         { storage: '1Gi' }
          persistent-volume-reclaim-policy: 'Retain'
          storage-class-name:               'unobin-it-static-volume'
          volume-mode:                      'Filesystem'
          persistent-volume-source: {
            host-path: { path: '/unobin/lookup-fixture', type: 'DirectoryOrCreate' }
          }
        }
      }
    }
    persistent-volume-claim-claim: core.persistent-volume-claim {
      object: {
        metadata: {
          generate-name: 'unobin-it-claim-'
          namespace:     'default'
          labels: {
            'test.unobin.cloudboss.io/scenario': 'core-v1-persistent-volume-claim'
            value:                               input.persistent-volume-claim-value
          }
          annotations: { 'example.com/value': input.persistent-volume-claim-value }
        }
        spec: { access-modes: ['ReadWriteOnce'], resources: { requests: { storage: '1Gi' } } }
      }
      wait-until-bound: false
    }
    pod-stable: core.pod {
      metadata: {
        generate-name: 'unobin-it-pod-stable-'
        labels: {
          'test.unobin.cloudboss.io/scenario': 'core-v1-pod'
          role:                                'stable'
          epoch:                               input.pod-epoch
        }
      }
      spec: {
        active-deadline-seconds:          input.pod-deadline
        termination-grace-period-seconds: 0
        container:                        [{ name: 'app', image: 'registry.k8s.io/pause:3.9' }]
      }
      target-state:   input.pod-phase
      create-timeout: '2m'
      delete-timeout: '30s'
    }
    pod-replaced: core.pod {
      metadata: {
        generate-name: 'unobin-it-pod-replace-'
        labels:        { 'test.unobin.cloudboss.io/scenario': 'core-v1-pod', role: 'replacement' }
      }
      spec: {
        node-selector:                    { 'test.unobin.cloudboss.io/unscheduled': 'true' }
        termination-grace-period-seconds: 0
        container:                        [{ name: 'app', image: input.pod-image }]
      }
      target-state:   ['Pending']
      create-timeout: '2m'
      delete-timeout: '30s'
    }
    secret-lookup-fixture: core.secret {
      object: {
        metadata: {
          generate-name: 'unobin-it-secret-lookup-'
          labels: {
            'app.kubernetes.io/name':            'synthetic'
            'kubernetes.io/metadata.name':       'kept'
            'test.unobin.cloudboss.io/scenario': 'core-v1-secret-lookup'
          }
          annotations: { 'deployment.kubernetes.io/revision': '9' }
        }
        type:      'example.test/custom'
        immutable: true
        data:      { unicode: '日本語', empty-text: '' }
        binary-data: {
          text:        'IP/+6Zuq/++/vSBlzIEJCg=='
          bytes:       'IP/+6Zuq/++/vSBlzIEJCg=='
          empty-bytes: ''
        }
      }
    }
    secret-data-fixture: core.secret {
      object: {
        metadata: {
          generate-name: 'unobin-it-secret-data-'
          labels:        { 'test.unobin.cloudboss.io/scenario': 'core-v1-secret-data' }
          annotations:   { fixture: 'preserved' }
        }
        type:        'example.test/custom'
        binary-data: { base: 'b3JpZ2luYWw=', binary: 'AP/+AQ==' }
      }
    }
    secret-data: core.secret-data {
      object: {
        metadata: { name: resource.secret-data-fixture.object.metadata.name }
        data:     input.secret-data-values
      }
      force: input.secret-data-force
    }
    secret-data-temporary: core.secret-data {
      @for-each: input.temporary-secret-data
      object: {
        metadata: { name: resource.secret-data-fixture.object.metadata.name }
        data:     { temporary: 'remove with attachment' }
      }
      field-manager: 'temporary'
    }
    secret-mutable: core.secret {
      object: {
        metadata: {
          generate-name: 'unobin-it-secret-mutable-'
          labels:        { 'test.unobin.cloudboss.io/scenario': 'core-v1-secret', role: 'mutable' }
        }
        data:        { value: input.secret-value }
        binary-data: { bytes: input.secret-binary-value, empty: '' }
        immutable:   input.secret-immutable
      }
    }
    secret-locked: core.secret {
      object: {
        metadata: {
          generate-name: 'unobin-it-secret-locked-'
          labels:        { 'test.unobin.cloudboss.io/scenario': 'core-v1-secret', role: 'locked' }
        }
        data:        { value: input.secret-value }
        binary-data: { bytes: input.secret-binary-value, empty: '' }
        immutable:   true
      }
    }
    service-stable: core.service {
      metadata: {
        generate-name: 'unobin-it-service-stable-'
        labels:        { 'test.unobin.cloudboss.io/scenario': 'core-v1-service', role: 'stable' }
      }
      spec: {
        selector: { app: input.service-value }
        port:     [{ name: 'http', port: 80, target-port: input.service-target-port }]
      }
    }
    service-replaced: core.service {
      metadata: {
        generate-name: input.service-replacement-prefix
        labels: { 'test.unobin.cloudboss.io/scenario': 'core-v1-service', role: 'replacement' }
      }
      spec: { port: [{ port: 81 }] }
    }
    default-service-account: core.default-service-account {
      object: {
        metadata: {
          namespace:   data-source.default-service-account-before.metadata.namespace
          labels:      { value: input.service-account-value }
          annotations: { 'example.com/value': input.service-account-value }
        }
        automount-service-account-token: input.service-account-automount
        image-pull-secrets:              [{ name: input.service-account-value }]
        secrets:                         [{ name: input.service-account-value }]
      }
    }
    service-account-explicit: core.service-account {
      object: {
        metadata: {
          generate-name: 'unobin-it-service-account-'
          labels: {
            'test.unobin.cloudboss.io/scenario': 'core-v1-service-account'
            role:                                'explicit'
            value:                               input.service-account-value
          }
          annotations: { 'example.com/value': input.service-account-value }
        }
        image-pull-secrets:              [{ name: input.service-account-value }]
        secrets:                         [{ name: input.service-account-value }]
        automount-service-account-token: input.service-account-automount
      }
    }
    service-account-defaulted: core.service-account {
      object: {
        metadata: {
          generate-name: 'unobin-it-service-account-'
          labels: {
            'test.unobin.cloudboss.io/scenario': 'core-v1-service-account'
            role:                                'defaulted'
            value:                               input.service-account-value
          }
          annotations: { 'example.com/value': input.service-account-value }
        }
        image-pull-secrets: [{ name: input.service-account-value }]
        secrets:            [{ name: input.service-account-value }]
      }
    }
  }
  data-sources: {
    config-map-lookup-existing: core.config-map {
      metadata: {
        name:        resource.config-map-lookup-settings.object.metadata.name
        namespace:   resource.config-map-lookup-settings.object.metadata.namespace
        annotations: { 'EXAMPLE.COM/Lookup': 'not-a-selector' }
        labels:      { lookup: 'not-a-selector' }
      }
      immutable: true
    }
    config-map-lookup-missing: core.config-map {
      metadata:  { name: 'unobin-it-config-map-info-absent', namespace: 'default' }
      immutable: true
    }
    endpoints-lookup-existing: core-namespace-lookup.endpoints {
      metadata: {
        name:          resource.endpoints-lookup-fixture.name
        generate-name: 'ignored-'
        labels:        { lookup: 'ignored' }
        annotations:   { lookup: 'ignored' }
      }
      subset: [{ port: [{ port: 1234 }] }]
    }
    endpoints-lookup-missing: core-namespace-lookup.endpoints {
      metadata: {
        name:          'unobin-it-core-v1-endpoints-lookup-absent'
        generate-name: 'fallback-'
        annotations:   { 'EXAMPLE.COM/Lookup': 'fallback text', omitted: null }
        labels:        { lookup: '', omitted: null }
      }
      subset: [
        {},
        {
          address:           [{ ip: 'not parsed', node-name: null }]
          not-ready-address: [{ ip: '2001:DB8::2', hostname: 'odd name' }]
          port:              [{ port: 1099511627776, protocol: null }, { port: -1, protocol: '' }]
        },
      ]
    }
    namespace-lookup-existing: core-namespace-lookup.namespace {
      metadata: {
        name:        'default'
        annotations: { 'EXAMPLE.COM/Lookup': input.namespace-lookup-value }
        labels:      { lookup: input.namespace-lookup-value }
      }
    }
    namespace-lookup-empty: core-namespace-lookup.namespace {
      metadata: { name: 'kube-public' }
    }
    namespace-lookup-missing: core-namespace-lookup.namespace {
      metadata: {
        name:        'unobin-it-namespace-info-absent'
        annotations: { lookup: input.namespace-lookup-value, omitted: null }
        labels:      { omitted: null }
      }
    }
    persistent-volume-existing: core-namespace-lookup.persistent-volume {
      metadata: {
        name:        resource.persistent-volume-update.object.metadata.name
        labels:      { lookup: input.persistent-volume-lookup-value }
        annotations: { 'EXAMPLE.COM/Lookup': input.persistent-volume-lookup-value }
      }
    }
    persistent-volume-temporary: core-namespace-lookup.persistent-volume {
      @for-each: input.temporary-pv-lookups
      metadata:  { name: resource.persistent-volume-lookup-fixture.object.metadata.name }
    }
    namespaces: core.namespaces {
      @depends-on: [resource.namespace-project]
    }
    nodes-selected: core.nodes {
      metadata: {
        labels: { 'unobin.cloudboss.com/nodes-integration-absent': input.nodes-selector }
      }
    }
    default-service-account-before: core.service-account {
      metadata: { name: 'default', namespace: resource.namespace-project.object.metadata.name }
    }
    secret-lookup-existing: core-namespace-lookup.secret {
      @for-each: input.temporary-secret-lookups
      metadata: {
        name:          resource.secret-lookup-fixture.object.metadata.name
        generate-name: 'lookup-only-'
        annotations:   { 'example.com/unused': 'unused' }
      }
      binary-data: { bytes: 'not base64', empty-bytes: '', absent: 'unused', unicode: null }
    }
    secret-lookup-missing: core-namespace-lookup.secret {
      metadata: {
        name:          'unobin-it-secret-lookup-absent'
        namespace:     null
        generate-name: 'missing-'
        annotations:   { 'EXAMPLE.COM/Lookup': 'missing', 'bad key': null }
        labels:        { app: 'missing', 'bad key': null }
      }
      binary-data: { missing: 'synthetic placeholder', unused: null }
    }
    service-account-lookup-existing: core.service-account {
      metadata: {
        name:      resource.service-account-explicit.object.metadata.name
        namespace: resource.service-account-explicit.object.metadata.namespace
        labels:    { lookup: 'different' }
      }
    }
    service-account-lookup-missing: core.service-account {
      metadata: {
        name:        'unobin-it-service-account-lookup-absent'
        annotations: { 'EXAMPLE.COM/Lookup': 'fallback', omitted: null }
      }
    }
    server-version: core.server-version {}
    service-lookup-existing: core.service {
      metadata: {
        name:        'kubernetes'
        namespace:   'default'
        annotations: { 'EXAMPLE.COM/Lookup': input.service-lookup-value }
        labels:      { unobin-lookup: input.service-lookup-value }
      }
    }
    service-lookup-missing: core.service {
      metadata: { name: 'unobin-it-service-info-absent', namespace: 'default' }
    }
  }
  outputs: {
    config-map: {
      value: {
        name:        resource.config-map-settings.object.metadata.name
        namespace:   resource.config-map-settings.object.metadata.namespace
        uid:         resource.config-map-settings.object.metadata.uid
        data:        resource.config-map-settings.object.data
        binary-data: resource.config-map-settings.object.binary-data
        immutable:   resource.config-map-settings.object.immutable
      }
    }
    config-map-lookup: {
      value: {
        metadata:            data-source.config-map-lookup-existing.metadata
        data:                data-source.config-map-lookup-existing.data
        binary-data:         data-source.config-map-lookup-existing.binary-data
        immutable:           data-source.config-map-lookup-existing.immutable
        missing-metadata:    data-source.config-map-lookup-missing.metadata
        missing-data:        data-source.config-map-lookup-missing.data
        missing-binary-data: data-source.config-map-lookup-missing.binary-data
        missing-immutable:   data-source.config-map-lookup-missing.immutable
      }
    }
    endpoints-lookup: {
      value: {
        existing: {
          metadata: data-source.endpoints-lookup-existing.metadata
          subset:   data-source.endpoints-lookup-existing.subset
        }
        missing: {
          metadata: data-source.endpoints-lookup-missing.metadata
          subset:   data-source.endpoints-lookup-missing.subset
        }
      }
    }
    namespace: {
      value: {
        name: resource.namespace-project.object.metadata.name
        uid:  resource.namespace-project.object.metadata.uid
      }
    }
    namespace-lookup: {
      value: {
        metadata:         data-source.namespace-lookup-existing.metadata
        spec:             data-source.namespace-lookup-existing.spec
        empty-spec:       data-source.namespace-lookup-empty.spec
        missing-metadata: data-source.namespace-lookup-missing.metadata
        missing-spec:     data-source.namespace-lookup-missing.spec
      }
    }
    namespaces: { value: data-source.namespaces.namespaces }
    node-taint: {
      value: {
        original-uid: resource.node-taint-fixture.uid
        uid:          resource.node-taint.object.metadata.uid
        name:         resource.node-taint.object.metadata.name
        api-version:  resource.node-taint.api-version
        kind:         resource.node-taint.kind
        taints:       resource.node-taint.object.spec.taints
      }
    }
    nodes: {
      value: {
        nodes: data-source.nodes-selected.nodes
      }
    }
    persistent-volume: {
      value: {
        updated-uid:     resource.persistent-volume-update.object.metadata.uid
        replacement-uid: resource.persistent-volume-replacement.object.metadata.uid
      }
    }
    persistent-volume-lookup: {
      value: {
        metadata: data-source.persistent-volume-existing.metadata
        spec:     data-source.persistent-volume-existing.spec
      }
    }
    persistent-volume-claim: {
      value: {
        name: resource.persistent-volume-claim-claim.object.metadata.name
        uid:  resource.persistent-volume-claim-claim.object.metadata.uid
      }
    }
    pod: {
      value: {
        stable-name:      resource.pod-stable.metadata.name
        stable-uid:       resource.pod-stable.uid
        replacement-name: resource.pod-replaced.name
        replacement-uid:  resource.pod-replaced.uid
      }
    }
    secret: {
      value: {
        mutable-name: resource.secret-mutable.object.metadata.name
        locked-name:  resource.secret-locked.object.metadata.name
      }
    }
    service: {
      value: {
        name:             resource.service-stable.name
        uid:              resource.service-stable.uid
        cluster-ip:       resource.service-stable.spec.cluster-ip
        cluster-ips:      resource.service-stable.spec.cluster-ips
        ip-families:      resource.service-stable.spec.ip-families
        ports:            resource.service-stable.spec.port
        replacement-name: resource.service-replaced.name
        replacement-uid:  resource.service-replaced.uid
      }
    }
    default-service-account: {
      value: {
        original-uid:        data-source.default-service-account-before.metadata.uid
        uid:                 resource.default-service-account.object.metadata.uid
        namespace:           resource.default-service-account.object.metadata.namespace
        name:                resource.default-service-account.object.metadata.name
        image-pull-secrets:  resource.default-service-account.object.image-pull-secrets
        secrets:             resource.default-service-account.object.secrets
        automount:           resource.default-service-account.object.automount-service-account-token
        default-secret-name: resource.default-service-account.default-secret-name
        api-version:         resource.default-service-account.api-version
        kind:                resource.default-service-account.kind
      }
    }
    service-account: {
      value: {
        explicit-name:       resource.service-account-explicit.object.metadata.name
        explicit-uid:        resource.service-account-explicit.object.metadata.uid
        defaulted-name:      resource.service-account-defaulted.object.metadata.name
        defaulted-uid:       resource.service-account-defaulted.object.metadata.uid
        default-secret-name: resource.service-account-defaulted.default-secret-name
      }
    }
    service-account-lookup: {
      value: {
        metadata:                    data-source.service-account-lookup-existing.metadata
        automount:                   data-source.service-account-lookup-existing.automount-service-account-token
        secrets:                     data-source.service-account-lookup-existing.secrets
        image-pull-secrets:          data-source.service-account-lookup-existing.image-pull-secrets
        default-secret-name:         data-source.service-account-lookup-existing.default-secret-name
        missing-metadata:            data-source.service-account-lookup-missing.metadata
        missing-automount:           data-source.service-account-lookup-missing.automount-service-account-token
        missing-secrets:             data-source.service-account-lookup-missing.secrets
        missing-image-pull-secrets:  data-source.service-account-lookup-missing.image-pull-secrets
        missing-default-secret-name: data-source.service-account-lookup-missing.default-secret-name
      }
    }
    server-version: {
      value: {
        version:        data-source.server-version.version
        build-date:     data-source.server-version.build-date
        compiler:       data-source.server-version.compiler
        git-commit:     data-source.server-version.git-commit
        git-tree-state: data-source.server-version.git-tree-state
        git-version:    data-source.server-version.git-version
        go-version:     data-source.server-version.go-version
        major:          data-source.server-version.major
        minor:          data-source.server-version.minor
        platform:       data-source.server-version.platform
      }
    }
    service-lookup: {
      value: {
        metadata:         data-source.service-lookup-existing.metadata
        spec:             data-source.service-lookup-existing.spec
        status:           data-source.service-lookup-existing.status
        missing-metadata: data-source.service-lookup-missing.metadata
        missing-spec:     data-source.service-lookup-missing.spec
        missing-status:   data-source.service-lookup-missing.status
      }
    }
  }
}
