factory: {
  imports: {
    storage:                      'github.com/cloudboss/unobin-library-kubernetes//api/storage/v1'
    dynamic:                      'github.com/cloudboss/unobin-library-kubernetes//dynamic'
    storage-storage-class-lookup: 'github.com/cloudboss/unobin-library-kubernetes//api/storage/v1'
  }
  library-configs: {
    storage:                      {}
    dynamic:                      {}
    storage-storage-class-lookup: { namespace: 'ignored' }
  }
  inputs: {
    csi-driver-revision: { type: string }
    csi-driver-spec: {
      type: optional(object({ attach-required: boolean, pod-info-on-mount: optional(boolean) }))
    }
    storage-class-revision:        { type: string }
    storage-class-expansion:       { type: boolean }
    storage-class-lookup-fallback: { type: string }
  }
  resources: {
    csi-driver-driver: storage.csi-driver {
      metadata: {
        generate-name: 'unobin-it-csi-'
        labels:        { 'test.unobin.cloudboss.io/scenario': 'storage-v1-csi-driver' }
        annotations:   { 'test.unobin.cloudboss.io/revision': input.csi-driver-revision }
      }
      spec: input.csi-driver-spec
    }
    storage-class-class: storage.storage-class {
      metadata: {
        generate-name: 'unobin-it-storage-'
        labels:        { 'test.unobin.cloudboss.io/scenario': 'storage-v1-storage-class' }
        annotations:   { 'test.unobin.cloudboss.io/revision': input.storage-class-revision }
      }
      provisioner:            'kubernetes.io/no-provisioner'
      volume-binding-mode:    'WaitForFirstConsumer'
      allow-volume-expansion: input.storage-class-expansion
      mount-options:          ['nosuid', 'noexec', 'nosuid']
    }
    storage-class-lookup-class: dynamic.object {
      manifest: '''|-
        apiVersion: storage.k8s.io/v1
        kind: StorageClass
        metadata:
          name: unobin-it-storage-class-info
          labels:
            test.unobin.cloudboss.io/scenario: storage-class-info
          annotations:
            kubectl.kubernetes.io/last-applied-configuration: full
        provisioner: kubernetes.io/no-provisioner
        parameters:
          tier: fast
        allowVolumeExpansion: false
        mountOptions:
          - nosuid
          - noexec
        allowedTopologies:
          - matchLabelExpressions:
              - key: topology.kubernetes.io/zone
                values:
                  - west
                  - east
        '''
    }
  }
  data-sources: {
    storage-class-lookup-hit: storage-storage-class-lookup.storage-class {
      metadata: {
        name:        resource.storage-class-lookup-class.name
        annotations: { wrong: 'configured' }
        labels:      { wrong: 'configured' }
      }
      parameters:             { tier: 'wrong' }
      reclaim-policy:         'Retain'
      volume-binding-mode:    'WaitForFirstConsumer'
      allow-volume-expansion: true
    }
    storage-class-lookup-miss: storage-storage-class-lookup.storage-class {
      metadata: {
        name:        'unobin-it-storage-class-info-absent'
        annotations: { 'EXAMPLE.COM/Lookup': input.storage-class-lookup-fallback, '_omitted': null }
        labels:      { 'example.com/Lookup': '', '_omitted': null }
      }
      parameters:             { tier: 'fallback', omitted: null }
      reclaim-policy:         'Fallback'
      volume-binding-mode:    ''
      allow-volume-expansion: false
      mount-options:          ['nosuid', 'noexec', 'nosuid']
      allowed-topologies:     [{ match-label-expressions: [{ values: ['west', 'east', 'west'] }] }]
    }
  }
  outputs: {
    csi-driver: {
      value: {
        name: resource.csi-driver-driver.metadata.name
        uid:  resource.csi-driver-driver.metadata.uid
        spec: resource.csi-driver-driver.spec
      }
    }
    storage-class: {
      value: {
        name:          resource.storage-class-class.metadata.name
        uid:           resource.storage-class-class.metadata.uid
        expansion:     resource.storage-class-class.allow-volume-expansion
        mount-options: resource.storage-class-class.mount-options
      }
    }
    storage-class-lookup: {
      value: {
        hit: {
          metadata:               data-source.storage-class-lookup-hit.metadata
          provisioner:            data-source.storage-class-lookup-hit.provisioner
          parameters:             data-source.storage-class-lookup-hit.parameters
          reclaim-policy:         data-source.storage-class-lookup-hit.reclaim-policy
          volume-binding-mode:    data-source.storage-class-lookup-hit.volume-binding-mode
          allow-volume-expansion: data-source.storage-class-lookup-hit.allow-volume-expansion
          mount-options:          data-source.storage-class-lookup-hit.mount-options
          allowed-topologies:     data-source.storage-class-lookup-hit.allowed-topologies
        }
        miss: {
          metadata:               data-source.storage-class-lookup-miss.metadata
          provisioner:            data-source.storage-class-lookup-miss.provisioner
          parameters:             data-source.storage-class-lookup-miss.parameters
          reclaim-policy:         data-source.storage-class-lookup-miss.reclaim-policy
          volume-binding-mode:    data-source.storage-class-lookup-miss.volume-binding-mode
          allow-volume-expansion: data-source.storage-class-lookup-miss.allow-volume-expansion
          mount-options:          data-source.storage-class-lookup-miss.mount-options
          allowed-topologies:     data-source.storage-class-lookup-miss.allowed-topologies
        }
      }
    }
  }
}
