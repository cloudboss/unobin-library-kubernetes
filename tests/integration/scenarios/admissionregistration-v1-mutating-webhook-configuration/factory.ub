factory: {
  imports: {
    admission: 'github.com/cloudboss/unobin-library-kubernetes//api/admissionregistration/v1'
  }
  library-configs: { admission: {} }
  inputs: {
    revision: { type: string }
    policy:   { type: optional(string), default: null }
  }
  resources: {
    example: admission.mutating-webhook-configuration {
      metadata: {
        generate-name: 'unobin-it-mutating-webhook-a11-'
        labels:        { 'test.unobin.cloudboss.io/scenario': 'mutating-webhook-configuration' }
        annotations:   { 'test.unobin.cloudboss.io/revision': input.revision }
      }
      webhook: [
        {
          name: 'mutation.test.unobin.cloudboss.io'
          client-config: {
            service: {
              name:      'inert-mutating-webhook'
              namespace: 'unobin-it-mutating-webhook'
            }
          }
          admission-review-versions: ['v1']
          side-effects:              'None'
          failure-policy:            'Ignore'
          reinvocation-policy:       input.policy
          namespace-selector: {
            match-labels: {
              'test.unobin.cloudboss.io/scenario': 'mutating-webhook-configuration'
            }
          }
          object-selector: {
            match-labels: {
              'test.unobin.cloudboss.io/scenario': 'mutating-webhook-configuration'
            }
          }
        },
      ]
    }
  }
  outputs: {
    name:    { value: resource.example.name }
    uid:     { value: resource.example.uid }
    webhook: { value: resource.example.webhook }
  }
}
