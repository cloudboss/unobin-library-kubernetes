factory: {
  description: '''>-
    Updates one ResourceQuota in place and replaces a
    generated ResourceQuota when its scope changes.
    '''
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: {} }
  inputs: {
    pods:           { type: string }
    priority-class: { type: string }
    scope:          { type: string }
  }
  resources: {
    explicit: core.resource-quota {
      metadata: {
        name: 'unobin-it-quota-explicit'
        labels: {
          'test.unobin.cloudboss.io/scenario': 'core-v1-resource-quota'
          identity:                            'explicit'
        }
      }
      spec: {
        hard: { pods: input.pods }
        scope-selector: {
          match-expressions: [
            { scope-name: 'PriorityClass', operator: 'In', values: [input.priority-class] },
          ]
        }
      }
    }
    generated: core.resource-quota {
      metadata: {
        generate-name: 'unobin-it-quota-'
        labels: {
          'test.unobin.cloudboss.io/scenario': 'core-v1-resource-quota'
          identity:                            'generated'
        }
      }
      spec: {
        hard:   { pods: '7' }
        scopes: [input.scope]
      }
    }
  }
  outputs: {
    explicit:  { value: resource.explicit.name }
    generated: { value: resource.generated.name }
  }
}
