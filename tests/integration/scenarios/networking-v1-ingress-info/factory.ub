factory: {
  description: 'Reads a created Ingress and returns lookup metadata for a missing Ingress.'
  imports:     { networking: 'github.com/cloudboss/unobin-library-kubernetes//api/networking/v1' }
  library-configs: { networking: {} }
  inputs:          { lookup-label: { type: string } }
  resources: {
    route: networking.ingress {
      metadata: {
        generate-name: 'unobin-it-ingress-info-'
        labels:        { 'unobin.example/scenario': 'ingress-info' }
        annotations:   { 'unobin.example/Note': 'observed' }
      }
      spec: {
        default-backend: { service: { name: 'app', port: { number: 80 } } }
        rule: [
          {
            host: 'app.example.com'
            http: {
              path: [
                {
                  path:      '/app'
                  path-type: 'Prefix'
                  backend:   { service: { name: 'app', port: { name: 'web' } } }
                },
              ]
            }
          },
        ]
        tls: [{ hosts: ['app.example.com'], secret-name: 'app-tls' }]
      }
    }
  }
  data-sources: {
    route: networking.ingress-info {
      metadata: {
        name:   resource.route.name
        labels: { 'unobin.example/lookup': input.lookup-label }
      }
    }
    missing: networking.ingress-info {
      metadata: {
        name:   'unobin-it-ingress-info-missing'
        labels: { 'unobin.example/lookup': input.lookup-label, 'skip this': null }
      }
    }
  }
  outputs: {
    name:             { value: resource.route.name }
    metadata:         { value: data-source.route.metadata }
    spec:             { value: data-source.route.spec }
    status:           { value: data-source.route.status }
    missing-metadata: { value: data-source.missing.metadata }
    missing-spec:     { value: data-source.missing.spec }
    missing-status:   { value: data-source.missing.status }
  }
}
