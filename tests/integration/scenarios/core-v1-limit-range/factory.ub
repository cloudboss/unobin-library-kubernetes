factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: {} }
  inputs: {
    limit-type: { type: string }
    clear:      { type: boolean }
  }
  resources: {
    generated: core.limit-range {
      object: {
        metadata: {
          generate-name: 'unobin-it-limit-'
          labels: {
            'test.unobin.cloudboss.io/scenario': 'core-v1-limit-range'
            identity:                            'generated'
          }
          annotations: { 'example.com/policy': input.limit-type }
        }
        spec: {
          limit: [
            {
              type:    input.limit-type
              default: if input.limit-type == 'Container' then { cpu: '0.5' } else null
              max:     { cpu: if input.limit-type == 'Container' then '1' else '2' }
            },
          ]
        }
      }
    }
    explicit: core.limit-range {
      object: {
        metadata: {
          name: 'unobin-it-limit-explicit'
          labels: {
            'test.unobin.cloudboss.io/scenario': 'core-v1-limit-range'
            identity:                            'explicit'
          }
        }
        spec: if input.clear then null else { limit: [{ type: 'Pod', max: { memory: '1Gi' } }] }
      }
    }
  }
  outputs: {
    generated:      { value: resource.generated.object.metadata.name }
    generated-spec: { value: resource.generated.object.spec }
  }
}
