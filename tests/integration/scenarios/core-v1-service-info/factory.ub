factory: {
  description:     'Reads existing and missing Services without changing either.'
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: {} }
  inputs:          { value: { type: string } }
  data-sources: {
    existing: core.service-info {
      metadata: {
        name:        'kubernetes'
        namespace:   'default'
        annotations: { 'EXAMPLE.COM/Lookup': input.value }
        labels:      { unobin-lookup: input.value }
      }
    }
    missing: core.service-info {
      metadata: { name: 'unobin-it-service-info-absent', namespace: 'default' }
    }
  }
  outputs: {
    metadata:         { value: data-source.existing.metadata }
    spec:             { value: data-source.existing.spec }
    status:           { value: data-source.existing.status }
    missing-metadata: { value: data-source.missing.metadata }
    missing-spec:     { value: data-source.missing.spec }
    missing-status:   { value: data-source.missing.status }
  }
}
