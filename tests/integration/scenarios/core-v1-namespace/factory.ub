factory: {
  description: '''>-
    Creates a generated Namespace, waits for its default ServiceAccount, and updates metadata.
    '''

  imports: {
    kubernetes: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1'
  }

  library-configs: { kubernetes: {} }

  inputs: {
    value: { type: string }
  }

  resources: {
    project: kubernetes.namespace {
      object: {
        metadata: {
          generate-name: 'unobin-it-namespace-'
          labels: {
            'test.unobin.cloudboss.io/scenario': 'core-v1-namespace'
            value:                               input.value
          }
          annotations: { 'example.com/value': input.value }
        }
      }
      wait-for-default-service-account: true
      delete-timeout:                   '30s'
    }
  }

  outputs: {
    name: { value: resource.project.object.metadata.name }
    uid:  { value: resource.project.object.metadata.uid }
  }
}
