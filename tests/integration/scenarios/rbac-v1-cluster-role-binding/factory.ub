factory: {
  description: '''>-
    Creates a generated ClusterRoleBinding and updates its ordered subjects in place.
    '''
  imports:         { rbac: 'github.com/cloudboss/unobin-library-kubernetes//api/rbac/v1' }
  library-configs: { rbac: {} }
  inputs: {
    user:    { type: string }
    account: { type: string }
  }
  resources: {
    binding: rbac.cluster-role-binding {
      metadata: {
        generate-name: 'unobin-it-binding-'
        labels:        { 'test.unobin.cloudboss.io/scenario': 'rbac-v1-cluster-role-binding' }
      }
      role-ref: { api-group: 'rbac.authorization.k8s.io', kind: 'ClusterRole', name: 'view' }
      subject: [
        { kind: 'User', name: input.user, namespace: '' },
        { kind: 'Group', name: 'readers', api-group: '', namespace: '' },
        { kind: 'ServiceAccount', name: input.account },
        { kind: 'ServiceAccount', name: input.account },
      ]
    }
  }
  outputs: {
    name:     { value: resource.binding.name }
    uid:      { value: resource.binding.uid }
    role-ref: { value: resource.binding.role-ref }
    subject:  { value: resource.binding.subject }
  }
}
