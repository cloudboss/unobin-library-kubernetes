factory: {
  description: 'Creates Services, preserves an allocated address during update, and replaces an immutable identity.'
  imports: { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: {} }
  inputs: {
    value: { type: string }
    target-port: { type: string }
    replacement-prefix: { type: string }
  }
  resources: {
    stable: core.service {
      metadata: {
        generate-name: 'unobin-it-service-stable-'
        labels: { 'test.unobin.cloudboss.io/scenario': 'core-v1-service' role: 'stable' }
      }
      spec: {
        selector: { app: input.value }
        port: [{ name: 'http' port: 80 target-port: input.target-port }]
      }
    }
    replaced: core.service {
      metadata: {
        generate-name: input.replacement-prefix
        labels: { 'test.unobin.cloudboss.io/scenario': 'core-v1-service' role: 'replacement' }
      }
      spec: { port: [{ port: 81 }] }
    }
  }
  outputs: {
    name: { value: resource.stable.name }
    uid: { value: resource.stable.uid }
    cluster-ip: { value: resource.stable.spec.cluster-ip }
    cluster-ips: { value: resource.stable.spec.cluster-ips }
    ip-families: { value: resource.stable.spec.ip-families }
    ports: { value: resource.stable.spec.port }
    replacement-name: { value: resource.replaced.name }
    replacement-uid: { value: resource.replaced.uid }
  }
}
