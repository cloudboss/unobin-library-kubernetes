factory: {
  description: 'Creates and updates an unbound admission policy.'
  imports: {
    admission: 'github.com/cloudboss/unobin-library-kubernetes//api/admissionregistration/v1'
  }
  library-configs: { admission: {} }
  inputs:          { initial: { type: boolean } }
  resources: {
    policy: admission.validating-admission-policy {
      metadata: {
        generate-name: 'unobin-it-vap-'
        labels:        { 'test.unobin.cloudboss.io/scenario': 'validating-admission-policy' }
        annotations: if input.initial then { 'test.unobin.cloudboss.io/initial': 'true' } else null
      }
      spec: {
        audit-annotations: []
        failure-policy:    'Fail'
        match-constraints: {
          match-policy: if input.initial then 'Exact' else null
          object-selector: if input.initial
            then { match-labels: { unobin-test: 'isolated' } }
            else null
          resource-rules: [
            {
              api-groups:     ['']
              api-versions:   ['v1']
              operations:     ['CREATE']
              resources:      ['configmaps']
              resource-names: ['unobin-it-vap-fixture']
            },
          ]
        }
        validations: [{ expression: 'true', message: 'Test fixture' }]
        variables: if input.initial
          then [
            { name: 'first', expression: 'true' },
            { name: 'second', expression: 'variables.first' },
          ]
          else []
      }
    }
  }
  outputs: {
    name:   { value: resource.policy.metadata.name }
    uid:    { value: resource.policy.uid }
    policy: { value: resource.policy.spec }
  }
}
