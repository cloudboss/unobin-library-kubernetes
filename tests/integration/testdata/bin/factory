#!/bin/sh
set -eu
case "${1}" in
    pin) step=pin ;;
    plan)
        case "${*}" in
            *--destroy*) step="destroy-plan:${4}" ;;
            *update/config.ub*) step=plan-update ;;
            *) step=plan ;;
        esac
        ;;
    apply)
        case "${2}" in
            *destroy.ubp) step=destroy-apply ;;
            *plan-update.ubp) step=apply-update ;;
            *) step=apply ;;
        esac
        ;;
    *) exit 64 ;;
esac
printf '%s\n' "${step}" >> "${TRACE}"
[ "${FAIL_STEP:-}" != "${step}" ] || exit 42
