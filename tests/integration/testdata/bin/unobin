#!/bin/sh
set -eu
printf '%s\n' compile >> "${TRACE}"
[ "${FAIL_STEP:-}" != compile ] || exit 42
shift
while [ "${#}" -gt 0 ]; do
    case "${1}" in
        -o) out=${2}; shift 2 ;;
        --name) name=${2}; shift 2 ;;
        *) shift ;;
    esac
done
mkdir -p "${out}"
cp "${FAKE_FACTORY}" "${out}/${name}"
