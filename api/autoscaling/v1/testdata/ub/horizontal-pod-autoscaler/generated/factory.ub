factory: {
  imports:         { hpa: 'github.com/cloudboss/unobin-library-kubernetes//api/autoscaling/v1' }
  library-configs: { hpa: {} }
  resources: {
    hpa: hpa.horizontal-pod-autoscaler {
      object: {
        metadata: {
          generate-name: 'hpa-'
          labels:        { 'app.kubernetes.io/name': 'cpu_1' }
          annotations:   { 'Example.İK/Name': 'annotation' }
        }
        spec: {
          max-replicas:                      -4
          min-replicas:                      4294967297
          target-cpu-utilization-percentage: 0
          scale-target-ref:                  { api-version: '', name: '', kind: '' }
        }
      }
      ignore-labels:      ['^external/']
      ignore-annotations: ['^external/']
    }
  }
}
