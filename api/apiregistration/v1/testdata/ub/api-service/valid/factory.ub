factory: {
  imports: {
    registration: 'github.com/cloudboss/unobin-library-kubernetes//api/apiregistration/v1'
  }
  library-configs: { registration: { server: 'https://127.0.0.1:1' } }
  resources: {
    core: registration.api-service {
      metadata:      { name: 'v1.' }
      spec:          { group: '', version: 'v1', group-priority-minimum: 1, version-priority: 1 }
      ignore-labels: null
      ignore-annotations: null
    }
    remote: registration.api-service {
      metadata: {
        name:        'v1.example.test'
        annotations: { 'UPPER.example.test/Value': 'Any value' }
        labels:      { 'example.test/Value': '' }
      }
      spec: {
        group:                    'example.test'
        version:                  'v1'
        group-priority-minimum:   20000
        version-priority:         1000
        service:                  { name: 'proxy', namespace: 'backends', port: 65535 }
        ca-bundle:                ''
        insecure-skip-tls-verify: true
      }
    }
    tls: registration.api-service {
      metadata: { name: 'v2.example.test' }
      spec: {
        group:                  'example.test'
        version:                'v2'
        group-priority-minimum: 1
        version-priority:       1
        service:                { name: 'proxy', namespace: 'backends', port: 1 }
        ca-bundle:              'raw text'
      }
    }
    default-port: registration.api-service {
      metadata: { name: 'v3.example.test' }
      spec: {
        group:                    'example.test'
        version:                  'v3'
        group-priority-minimum:   1
        version-priority:         1
        service:                  { name: 'proxy', namespace: 'backends' }
        insecure-skip-tls-verify: false
      }
    }
    optional-null: registration.api-service {
      metadata: { name: 'v4.example.test', labels: null, annotations: null }
      spec: {
        group:                    'example.test'
        version:                  'v4'
        group-priority-minimum:   1
        version-priority:         1
        service:                  null
        ca-bundle:                null
        insecure-skip-tls-verify: null
      }
    }
  }
  outputs: {
    name:      { value: resource.core.metadata.name }
    uid:       { value: resource.remote.uid }
    ca-bundle: { value: resource.tls.spec.ca-bundle }
    service:   { value: resource.remote.spec.service }
  }
}
