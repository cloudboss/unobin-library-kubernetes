factory: {
  imports: {
    registration: 'github.com/cloudboss/unobin-library-kubernetes//api/apiregistration/v1'
  }
  library-configs: { registration: { server: 'https://127.0.0.1:1' } }
  resources: {
    name: registration.api-service {
      metadata: { name: 'mismatch' }
      spec: { group: 'example.test', version: 'v1', group-priority-minimum: 1, version-priority: 1 }
    }
    group: registration.api-service {
      metadata: { name: 'v1.Bad.test' }
      spec:     { group: 'Bad.test', version: 'v1', group-priority-minimum: 1, version-priority: 1 }
    }
    core: registration.api-service {
      metadata: { name: 'v2.' }
      spec:     { group: '', version: 'v2', group-priority-minimum: 1, version-priority: 1 }
    }
    version: registration.api-service {
      metadata: { name: '1v.example.test' }
      spec: { group: 'example.test', version: '1v', group-priority-minimum: 1, version-priority: 1 }
    }
    long-name: registration.api-service {
      metadata: {
        name: '''\-
          v1.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
          aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
          aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
          '''
      }
      spec: {
        group: '''\-
          aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
          aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
          aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
          '''
        version:                'v1'
        group-priority-minimum: 1
        version-priority:       1
      }
    }
    local-ca: registration.api-service {
      metadata: { name: 'v1.example.test' }
      spec: {
        group:                  'example.test'
        version:                'v1'
        group-priority-minimum: 1
        version-priority:       1
        ca-bundle:              'raw text'
      }
    }
    local-skip: registration.api-service {
      metadata: { name: 'v1.example.test' }
      spec: {
        group:                    'example.test'
        version:                  'v1'
        group-priority-minimum:   1
        version-priority:         1
        insecure-skip-tls-verify: true
      }
    }
    remote-tls: registration.api-service {
      metadata: { name: 'v1.example.test' }
      spec: {
        group:                    'example.test'
        version:                  'v1'
        group-priority-minimum:   1
        version-priority:         1
        service:                  { name: 'proxy', namespace: 'backends' }
        ca-bundle:                'raw text'
        insecure-skip-tls-verify: true
      }
    }
    empty-backend: registration.api-service {
      metadata: { name: 'v1.example.test' }
      spec: {
        group:                  'example.test'
        version:                'v1'
        group-priority-minimum: 1
        version-priority:       1
        service:                { name: '', namespace: '' }
      }
    }
    low: registration.api-service {
      metadata: { name: 'v1.example.test' }
      spec: {
        group:                  'example.test'
        version:                'v1'
        group-priority-minimum: 0
        version-priority:       0
        service:                { name: 'proxy', namespace: 'backends', port: 0 }
      }
    }
    high: registration.api-service {
      metadata: { name: 'v1.example.test' }
      spec: {
        group:                  'example.test'
        version:                'v1'
        group-priority-minimum: 20001
        version-priority:       1001
        service:                { name: 'proxy', namespace: 'backends', port: 65536 }
      }
    }
    metadata: registration.api-service {
      metadata: {
        name:        'v1.example.test'
        labels:      { 'UPPER.example.test/Value': 'bad value' }
        annotations: { '/': 'value' }
      }
      spec: { group: 'example.test', version: 'v1', group-priority-minimum: 1, version-priority: 1 }
      ignore-labels:      ['[']
      ignore-annotations: ['(']
    }
  }
}
