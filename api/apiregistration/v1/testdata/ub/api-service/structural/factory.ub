factory: {
  imports: {
    registration: 'github.com/cloudboss/unobin-library-kubernetes//api/apiregistration/v1'
  }
  library-configs: { registration: { server: 'https://127.0.0.1:1' } }
  resources: {
    missing-metadata: registration.api-service {

      spec: { group: 'example.test', version: 'v1', group-priority-minimum: 1, version-priority: 1 }
    }
    missing-spec: registration.api-service {
      metadata: { name: 'v1.example.test' }
    }
    missing-name: registration.api-service {
      metadata: {}
      spec: { group: 'example.test', version: 'v1', group-priority-minimum: 1, version-priority: 1 }
    }
    generated: registration.api-service {
      metadata: { name: 'v1.example.test', generate-name: 'v1.' }
      spec: { group: 'example.test', version: 'v1', group-priority-minimum: 1, version-priority: 1 }
    }
    missing-backend: registration.api-service {
      metadata: { name: 'v1.example.test' }
      spec: {
        group:                  'example.test'
        version:                'v1'
        group-priority-minimum: 1
        version-priority:       1
        service:                { name: 'proxy' }
      }
    }
    missing-backend-name: registration.api-service {
      metadata: { name: 'v1.example.test' }
      spec: {
        group:                  'example.test'
        version:                'v1'
        group-priority-minimum: 1
        version-priority:       1
        service:                { namespace: 'backends' }
      }
    }
    missing-spec-fields: registration.api-service {
      metadata: { name: 'v1.example.test' }
      spec:     {}
    }
    wrong-priority: registration.api-service {
      metadata: { name: 'v1.example.test' }
      spec: {
        group:                  'example.test'
        version:                'v1'
        group-priority-minimum: '1'
        version-priority:       1
      }
    }
    null-version: registration.api-service {
      metadata: { name: 'v1.example.test' }
      spec: { group: 'example.test', version: null, group-priority-minimum: 1, version-priority: 1 }
    }
  }
}
