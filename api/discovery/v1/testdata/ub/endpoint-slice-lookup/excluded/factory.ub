factory: {
  imports:         { discovery: 'github.com/cloudboss/unobin-library-kubernetes//api/discovery/v1' }
  library-configs: { discovery: {} }
  data-sources: {
    selected: discovery.endpoint-slice {
      metadata: { name: 'lookup' }
    }
  }
  outputs: {
    id:              { value: data-source.selected.id }
    status:          { value: data-source.selected.status }
    hints:           { value: data-source.selected.endpoints[0].hints }
    topology:        { value: data-source.selected.endpoints[0].topology }
    ref-kind:        { value: data-source.selected.endpoints[0].target-ref?.kind }
    ref-api-version: { value: data-source.selected.endpoints[0].target-ref?.api-version }
  }
}
