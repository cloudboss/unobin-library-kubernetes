factory: {
  imports:         { lease: 'github.com/cloudboss/unobin-library-kubernetes//api/coordination/v1' }
  library-configs: { lease: {} }
  resources: {
    subject: lease.lease {
      metadata: { generate-name: 'dotted.prefix-' }
      spec:     { holder-identity: '', lease-transitions: 0 }
    }
  }
}
