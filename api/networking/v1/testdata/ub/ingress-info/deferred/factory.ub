factory: {
  imports: { networking: 'github.com/cloudboss/unobin-library-kubernetes//api/networking/v1' }
  library-configs: { networking: { server: input.server } }
  actions: {
    seed: networking.seed {
      metadata: input.metadata
    }
  }
  data-sources: {
    endpoint: networking.ingress-info {
      metadata: action.seed.result
    }
  }
  outputs: {
    metadata: { value: data-source.endpoint.metadata }
  }
}
