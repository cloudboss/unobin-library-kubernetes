factory: {
  imports: { networking: 'github.com/cloudboss/unobin-library-kubernetes//api/networking/v1' }
  library-configs: { networking: {} }
  data-sources: {
    lookup: networking.network-policy {
      metadata: {
        name:      'example'
        namespace: 'nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn'
      }
    }
  }
  outputs: {
    policies: { value: data-source.lookup.spec?.policy-types }
    peers:    { value: data-source.lookup.spec?.egress }
  }
}
