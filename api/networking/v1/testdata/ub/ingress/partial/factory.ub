factory: {
  imports: { networking: 'github.com/cloudboss/unobin-library-kubernetes//api/networking/v1' }
  library-configs: { networking: { server: input.server } }
  actions: {
    seed: networking.seed {
      metadata: input.seed
    }
  }
  data-sources: {
    endpoint: networking.ingress {
      metadata: {
        name:      input.name
        namespace: action.seed.result.namespace
        labels: {
          'bad known':   input.known-key
          checked:       input.known-value
          'bad pending': action.seed.result.labels.pending
          kept:          action.seed.result.labels.kept
        }
        annotations: { 'bad annotation': input.known-annotation }
      }
    }
  }
  outputs: {
    metadata: { value: data-source.endpoint.metadata }
  }
}
