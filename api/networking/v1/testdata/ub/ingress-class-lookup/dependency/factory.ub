factory: {
  imports: { networking: 'github.com/cloudboss/unobin-library-kubernetes//api/networking/v1' }
  library-configs: { networking: { server: input.server, namespace: 'elsewhere' } }
  resources: {
    anchor: networking.anchor {
      value: input.name
    }
  }
  data-sources: {
    lookup: networking.ingress-class {
      metadata: { name: resource.anchor.value }
    }
  }
}
