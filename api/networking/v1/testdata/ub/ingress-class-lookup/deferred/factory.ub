factory: {
  imports: { networking: 'github.com/cloudboss/unobin-library-kubernetes//api/networking/v1' }
  library-configs: { networking: { server: input.server } }
  actions: {
    seed: networking.seed {
      values: input.metadata
    }
  }
  data-sources: {
    lookup: networking.ingress-class {
      metadata: action.seed.resolved
    }
  }
}
