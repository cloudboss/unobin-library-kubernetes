factory: {
  imports: {
    admission: 'github.com/cloudboss/unobin-library-kubernetes//api/admissionregistration/v1'
  }
  library-configs: { admission: {} }
  data-sources: {
    empty-name: admission.mutating-webhook-configuration {
      metadata: { name: '' }
    }
    uppercase-name: admission.mutating-webhook-configuration {
      metadata: { name: 'Upper' }
    }
    underscore-name: admission.mutating-webhook-configuration {
      metadata: { name: 'under_score' }
    }
    slash-name: admission.mutating-webhook-configuration {
      metadata: { name: 'foo/bar' }
    }
    long-name: admission.mutating-webhook-configuration {
      metadata: {
        name: '''\-
          aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
          aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
          aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
          '''
      }
    }
    label-syntax: admission.mutating-webhook-configuration {
      metadata: { name: 'good', labels: { 'Example.org/key': 'ok', 'x/y/z': 'ok', '-bad': 'ok' } }
    }
    label-prefix-length: admission.mutating-webhook-configuration {
      metadata: {
        name: 'good'
        labels: {
          'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/key': '''\-
            ok
            '''
        }
      }
    }
    label-suffix-length: admission.mutating-webhook-configuration {
      metadata: {
        name: 'good'
        labels: {
          'example.org/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa': 'ok'
        }
      }
    }
    label-value-syntax: admission.mutating-webhook-configuration {
      metadata: { name: 'good', labels: { a: 'has space', b: '-bad' } }
    }
    label-value-length: admission.mutating-webhook-configuration {
      metadata: {
        name:   'good'
        labels: { long: 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa' }
      }
    }
    annotation-syntax: admission.mutating-webhook-configuration {
      metadata: { name: 'good', annotations: { 'ex_ample.org/key': '', 'x/y/z': '', 'x/-bad': '' } }
    }
    annotation-prefix-length: admission.mutating-webhook-configuration {
      metadata: {
        name: 'good'
        annotations: {
          'AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA/key': '''\-
            annotation
            '''
        }
      }
    }
    annotation-suffix-length: admission.mutating-webhook-configuration {
      metadata: {
        name: 'good'
        annotations: {
          'EXAMPLE.ORG/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa': ''
        }
      }
    }
  }
}
