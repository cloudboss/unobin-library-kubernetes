factory: {
  imports:         { batch: 'github.com/cloudboss/unobin-library-kubernetes//api/batch/v1' }
  library-configs: { batch: { server: input.server, insecure-skip-tls-verify: true } }
  inputs: {
    server:          { type: string }
    completion-mode: { type: optional(string) }
  }
  resources: {
    workload: batch.job {
      metadata: { name: 'example' }
      spec: {
        completion-mode: input.completion-mode
        template:        { metadata: {}, spec: { container: [{ name: 'app' }] } }
      }
      delete-timeout: '2s'
    }
  }
}
