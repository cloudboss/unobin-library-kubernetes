factory: {
  imports: {
    crd: 'github.com/cloudboss/unobin-library-kubernetes//api/apiextensions/v1'
  }
  library-configs: { crd: {} }
  resources: {
    subject: crd.custom-resource-definition {
      metadata: { name: 'widgets.example.test' }
      spec: {
        group: 'example.test'
        names: { plural: 'widgets', kind: 'Widget' }
        scope: 'Invalid'
        versions: [
          {
            name:    'v1'
            served:  false
            storage: true
            schema: {
              type:       'object'
              properties: { spec: { type: 'object', x-kubernetes-preserve-unknown-fields: true } }
            }
          },
          { name: 'v2', served: false, storage: false },
        ]
      }
      wait-for-established: false
    }
  }
}
