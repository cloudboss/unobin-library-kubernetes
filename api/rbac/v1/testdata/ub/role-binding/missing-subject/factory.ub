factory: {
  imports:         { rbac: 'github.com/cloudboss/unobin-library-kubernetes//api/rbac/v1' }
  library-configs: { rbac: {} }
  resources: {
    binding: rbac.role-binding {
      metadata: { name: 'system:reader' }
      role-ref: { api-group: 'rbac.authorization.k8s.io', kind: 'Role', name: 'reader' }
    }
  }
  outputs: { name: { value: resource.binding.name } }
}
