factory: {
  imports: {
    rbac:   'github.com/cloudboss/unobin-library-kubernetes//api/rbac/v1'
    helper: 'github.com/cloudboss/unobin-library-kubernetes//api/rbac/v1'
  }
  library-configs: { rbac: { server: action.seed.resolved-server }, helper: {} }
  actions: {
    seed: helper.connection {
      server: input.server
    }
  }
  data-sources: {
    endpoint: rbac.cluster-role {
      metadata: input.metadata
    }
  }
  outputs: {
    metadata:         { value: data-source.endpoint.metadata }
    rules:            { value: data-source.endpoint.rules }
    aggregation-rule: { value: data-source.endpoint.aggregation-rule }
  }
}
