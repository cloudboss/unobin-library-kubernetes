factory: {
  imports:         { rbac: 'github.com/cloudboss/unobin-library-kubernetes//api/rbac/v1' }
  library-configs: { rbac: { server: input.server, namespace: 'ignored' } }
  inputs: {
    server:   { type: string }
    metadata: { type: object({ name: { type: string }, namespace: { type: string } }) }
  }
  resources: {
    fixed: rbac.fixed {
      value: 'unchanged'
    }
  }

  data-sources: {
    endpoint: rbac.role {
      @depends-on: [resource.fixed]
      metadata:    input.metadata
    }
  }
  outputs: {
    metadata: { value: data-source.endpoint.metadata }
    rules:    { value: data-source.endpoint.rules }
  }
}
