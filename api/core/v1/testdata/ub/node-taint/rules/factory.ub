factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: {} }
  resources: {
    empty-name: core.node-taint {
      object: {
        metadata: { name: '' }
        spec: {
          taints: [
            { key: 'example.com/b', value: '', effect: 'PreferNoSchedule' },
            { key: 'example.com/a', value: 'marked', effect: 'NoExecute' },
          ]
        }
      }
    }
    dns-name: core.node-taint {
      object: {
        metadata: { name: 'INVALID_NODE' }
        spec: {
          taints: [
            { key: 'example.com/b', value: '', effect: 'PreferNoSchedule' },
            { key: 'example.com/a', value: 'marked', effect: 'NoExecute' },
          ]
        }
      }
    }
    long-name: core.node-taint {
      object: {
        metadata: {
          name: '''\-
            aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
            aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
            aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
            '''
        }
        spec: {
          taints: [
            { key: 'example.com/b', value: '', effect: 'PreferNoSchedule' },
            { key: 'example.com/a', value: 'marked', effect: 'NoExecute' },
          ]
        }
      }
    }
    empty-list: core.node-taint {
      object: { metadata: { name: 'host' }, spec: { taints: [] } }
    }
    duplicate: core.node-taint {
      object: {
        metadata: { name: 'host' }
        spec: {
          taints: [
            { key: 'x', value: 'one', effect: 'NoSchedule' },
            { key: 'x', value: 'two', effect: 'NoExecute' },
          ]
        }
      }
    }
    empty-manager: core.node-taint {
      object: {
        metadata: { name: 'node.example' }
        spec: {
          taints: [
            { key: 'example.com/b', value: '', effect: 'PreferNoSchedule' },
            { key: 'example.com/a', value: 'marked', effect: 'NoExecute' },
          ]
        }
      }
      field-manager: ''
    }
    ascii-manager: core.node-taint {
      object: {
        metadata: { name: 'node.example' }
        spec: {
          taints: [
            { key: 'example.com/b', value: '', effect: 'PreferNoSchedule' },
            { key: 'example.com/a', value: 'marked', effect: 'NoExecute' },
          ]
        }
      }
      field-manager: ' \t '
    }
    unicode-manager: core.node-taint {
      object: {
        metadata: { name: 'node.example' }
        spec: {
          taints: [
            { key: 'example.com/b', value: '', effect: 'PreferNoSchedule' },
            { key: 'example.com/a', value: 'marked', effect: 'NoExecute' },
          ]
        }
      }
      field-manager: '  　'
    }
  }
}
