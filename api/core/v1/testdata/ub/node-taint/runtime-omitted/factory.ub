factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: { server: input.server, namespace: 'ignored' } }
  resources: {
    attachment: core.node-taint {
      object: input.object
    }
  }
  outputs: {
    name:   { value: resource.attachment.object.metadata.name }
    uid:    { value: resource.attachment.object.metadata.uid }
    taints: { value: resource.attachment.object.spec.taints }
  }
}
