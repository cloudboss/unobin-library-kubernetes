factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: {} }
  resources: {
    valid: core.node-taint {
      object: {
        metadata: { name: 'node.example' }
        spec: {
          taints: [
            { key: 'example.com/b', value: '', effect: 'PreferNoSchedule' },
            { key: 'example.com/a', value: 'marked', effect: 'NoExecute' },
          ]
        }
      }
    }
    null-options: core.node-taint {
      object: {
        metadata: { name: 'node.example' }
        spec: {
          taints: [
            { key: 'example.com/b', value: '', effect: 'PreferNoSchedule' },
            { key: 'example.com/a', value: 'marked', effect: 'NoExecute' },
          ]
        }
      }
      field-manager: null
      force:         null
    }
  }
}
