factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: { server: input.server } }
  inputs: {
    server:       { type: string }
    defer-name:   { type: boolean, default: false }
    defer-labels: { type: boolean, default: false }
    labels:       { type: optional(map(optional(string))) }
  }
  resources: {
    anchor: core.config-map {
      object: {
        metadata: { name: 'anchor', namespace: 'default' }
      }
    }
  }
  data-sources: {
    lookup: core.service-account {
      metadata: {
        name: if input.defer-name then resource.anchor.object.metadata.uid else 'lookup'
        labels: if input.defer-labels
          then { for key in [resource.anchor.object.metadata.uid] : key => 'label' }
          else input.labels
      }
    }
  }
}
