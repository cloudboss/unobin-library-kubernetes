factory: {
  imports: { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  inputs: {
    server:     { type: string }
    target:     { type: string }
    namespace:  { type: optional(string) }
    revision:   { type: string }
    deferred:   { type: boolean }
    defer-data: { type: boolean }
    data:       { type: map(string) }
    manager:    { type: optional(string) }
    force:      { type: optional(boolean) }
  }
  library-configs: { core: { server: input.server, namespace: 'other' } }
  resources: {
    seed: core.config-map {
      object: { metadata: { name: 'seed' }, data: { version: input.revision } }
    }
    attachment: core.secret-data {
      field-manager: input.manager
      force:         input.force
      object: {
        metadata: {
          name: if input.deferred && resource.seed.server == input.server
            then input.revision
            else input.target
          namespace: input.namespace
        }
        data: if input.defer-data && resource.seed.server == input.server
          then input.data
          else input.data
      }
    }
  }
  outputs: {
    object:  { value: resource.attachment.object }
    derived: { value: resource.attachment.object.data['value'], @sensitive: true }
  }
}
