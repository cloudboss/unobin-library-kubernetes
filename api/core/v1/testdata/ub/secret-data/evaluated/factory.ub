factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: { server: input.server } }
  inputs: {
    server:        { type: string }
    object:        { type: optional(opaque) }
    field-manager: { type: optional(opaque) }
    force:         { type: optional(opaque) }
  }
  resources: {
    attachment: core.secret-data {
      object:        @core.lookup({ value: input.object }, 'value')
      field-manager: @core.lookup({ value: input.field-manager }, 'value')
      force:         @core.lookup({ value: input.force }, 'value')
    }
  }
}
