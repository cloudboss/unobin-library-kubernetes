factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: {} }
  inputs:          { account-name: { type: string, default: 'default' } }
  resources: {
    account: core.default-service-account {
      object: {
        metadata:           { name: input.account-name }
        image-pull-secrets: [{}]
        secrets:            []
      }
    }
    omitted: core.default-service-account {
      object: { metadata: {} }
    }
    explicit: core.default-service-account {
      object: { metadata: { name: 'default', annotations: { 'EXAMPLE.COM/Note': 'any / value' } } }
    }
  }
}
