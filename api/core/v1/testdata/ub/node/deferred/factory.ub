factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: { server: input.server } }
  actions: {
    seed: core.seed {
      value: input.metadata
    }
  }
  data-sources: {
    subject: core.node {
      metadata: action.seed.result
    }
  }
  outputs: { metadata: { value: data-source.subject.metadata } }
}
