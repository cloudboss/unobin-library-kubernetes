factory: {
 imports: { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
 library-configs: { core: {} }
 resources: { account: core.service-account { object: { metadata: { name: 'example' } image-pull-secrets: [{ name: 'pull' }, {}] secrets: [{ name: 'secret' }, {}] automount-service-account-token: false } } }
 outputs: { name: { value: resource.account.object.metadata.name } token-name: { value: resource.account.default-secret-name } }
}
