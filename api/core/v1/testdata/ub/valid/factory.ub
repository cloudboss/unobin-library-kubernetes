factory: {
  imports: {
    kubernetes: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1'
  }
  library-configs: { kubernetes: {} }
  resources: {
    settings: kubernetes.config-map {
      object: {
        metadata: { name: 'example' namespace: 'default' labels: { app: 'test' } }
        data: { value: 'text' }
        binary-data: { bytes: 'AAE=' }
        immutable: false
      }
      ignore-annotations: ['ignored']
      ignore-labels: []
    }
  }
  outputs: {
    name: { value: resource.settings.object.metadata.name }
    uid: { value: resource.settings.object.metadata.uid }
    data: { value: resource.settings.object.data }
    binary-data: { value: resource.settings.object.binary-data }
    immutable: { value: resource.settings.object.immutable }
  }
}
