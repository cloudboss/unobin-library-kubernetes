factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: {} }
  resources: {
    subject: core.replication-controller {
      metadata: {
        name: 'subject'
      }
      spec: {
        selector: {}
        template: {
          metadata: {}
          spec: {
            affinity: {
              node-affinity: {
                preferred-during-scheduling-ignored-during-execution: [
                  {
                    preference: {
                      match-expressions: [
                        {
                          operator: 'In'
                        },
                      ]
                    }
                    weight: 1
                  },
                ]
              }
            }
          }
        }
      }
    }
  }
}
