factory: {
  imports: { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  inputs: { server: { type: string } }
  library-configs: { core: { server: input.server } }
  resources: {
    credentials: core.secret {
      object: {
        metadata: { name: 'example' }
        data: { value: 'secret-payload-test-value' }
      }
    }
  }
  outputs: {
    object: { value: resource.credentials.object }
    derived: { value: resource.credentials.object.data.value @sensitive: true }
  }
}
