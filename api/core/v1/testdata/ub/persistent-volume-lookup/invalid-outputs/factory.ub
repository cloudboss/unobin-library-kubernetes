factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: {} }
  data-sources: {
    volume: core.persistent-volume {
      metadata: { name: 'disk' }
    }
  }
  outputs: {
    id:            { value: data-source.volume.id }
    status:        { value: data-source.volume.status }
    namespace:     { value: data-source.volume.metadata.namespace }
    generate-name: { value: data-source.volume.metadata.generate-name }
  }
}
