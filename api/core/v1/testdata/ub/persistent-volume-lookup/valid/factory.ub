factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: {} }
  data-sources: {
    volume: core.persistent-volume {
      metadata: {
        name:        'disk.example'
        labels:      { 'example.com/Label': '' }
        annotations: { 'EXAMPLE.COM/Annotation': 'arbitrary value!' }
      }
    }
  }
  outputs: {
    uid:      { value: data-source.volume.metadata.uid }
    capacity: { value: data-source.volume.spec.capacity }
  }
}
