factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: { server: input.server } }
  inputs: {
    server:                 { type: string }
    port:                   { type: integer }
    node-port:              { type: integer }
    health-check-node-port: { type: integer }
    timeout-seconds:        { type: integer }
  }
  resources: {
    endpoint: core.service {
      metadata:               { name: 'range-test' }
      wait-for-load-balancer: false
      spec: {
        type:                    'LoadBalancer'
        external-traffic-policy: 'Local'
        session-affinity:        'ClientIP'
        port:                    [{ port: input.port, node-port: input.node-port }]
        health-check-node-port:  input.health-check-node-port
        session-affinity-config: { client-ip: { timeout-seconds: input.timeout-seconds } }
      }
    }
  }
}
