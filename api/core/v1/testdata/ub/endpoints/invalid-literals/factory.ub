factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: {} }
  data-sources: {
    empty-name: core.endpoints {
      metadata: { name: '' }
    }
    long-name: core.endpoints {
      metadata: {
        name: '''\-
          aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
          aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
          aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
          '''
      }
    }
    uppercase-name: core.endpoints {
      metadata: { name: 'Upper' }
    }
    empty-prefix: core.endpoints {
      metadata: { generate-name: '' }
    }
    invalid-prefix: core.endpoints {
      metadata: { generate-name: 'Upper-' }
    }
    invalid-label-key: core.endpoints {
      metadata: { labels: { 'UPPER.COM/label': '' } }
    }
    invalid-label-value: core.endpoints {
      metadata: { labels: { label: 'not valid' } }
    }
    invalid-annotation: core.endpoints {
      metadata: { annotations: { 'bad key': '' } }
    }
  }
}
