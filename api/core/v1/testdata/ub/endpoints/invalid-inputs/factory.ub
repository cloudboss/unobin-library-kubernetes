factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: {} }
  data-sources: {
    absent-metadata: core.endpoints {}
    null-metadata: core.endpoints {
      metadata: null
    }
    list-metadata: core.endpoints {
      metadata: [{ name: 'lookup.test' }]
    }
    subset-object: core.endpoints {
      metadata: {}
      subset:   {}
    }
    null-subset-member: core.endpoints {
      metadata: {}
      subset:   [null]
    }
    null-address-member: core.endpoints {
      metadata: {}
      subset:   [{ address: [null] }]
    }
    null-port-member: core.endpoints {
      metadata: {}
      subset:   [{ port: [null] }]
    }
    absent-ip: core.endpoints {
      metadata: {}
      subset:   [{ address: [{}] }]
    }
    null-ip: core.endpoints {
      metadata: {}
      subset:   [{ not-ready-address: [{ ip: null }] }]
    }
    absent-port: core.endpoints {
      metadata: {}
      subset:   [{ port: [{}] }]
    }
    null-port: core.endpoints {
      metadata: {}
      subset:   [{ port: [{ port: null }] }]
    }
    fractional-port: core.endpoints {
      metadata: {}
      subset:   [{ port: [{ port: 1.25 }] }]
    }
    string-port: core.endpoints {
      metadata: {}
      subset:   [{ port: [{ port: '80' }] }]
    }
    unknown-fields: core.endpoints {
      metadata: { uid: 'readonly', resource-version: 'readonly', generateName: 'camel-' }
      subset:   [{ address: [{ ip: '192.0.2.1', nodeName: 'camel', target-ref: {} }] }]
      status:   {}
    }
  }
}
