factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: {} }
  data-sources: {
    endpoint: core.endpoints {
      metadata: {
        name:          'lookup.test'
        generate-name: 'lookup-'
        namespace:     ''
        labels:        { 'example.com/Key': '', 'null key': null }
        annotations:   { 'EXAMPLE.COM/Key': 'arbitrary value', 'null key': null }
      }
      subset: [
        {},
        { address: [], not-ready-address: null, port: [] },
        {
          address:           [{ ip: 'not parsed', hostname: null, node-name: 'odd name' }]
          not-ready-address: [{ ip: '2001:0DB8::1' }]
          port: [{ name: 'odd name', port: 1099511627776, protocol: 'not parsed' }, { port: -1 }]
        },
      ]
    }
    absent: core.endpoints {
      metadata: {
        name:          null
        generate-name: null
        namespace:     null
        annotations:   null
        labels:        null
      }
      subset: null
    }
    omitted: core.endpoints {
      metadata: {}
    }
    empty: core.endpoints {
      metadata: { name: 'empty' }
      subset:   []
    }
  }
  outputs: {
    prefixes: { value: data-source.endpoint.metadata.generate-name }
    ids:      { value: data-source.endpoint.metadata.uid }
    subsets: {
      value: [
        for item in data-source.endpoint.subset :
        {
          address: [
            for addr in item.address :
            { ip: addr.ip, host: addr.hostname, node: addr.node-name }
          ]
          not-ready: [ for addr in item.not-ready-address : addr.ip ]
          port: [
            for port in item.port :
            { port: port.port, protocol: port.protocol, name: port.name }
          ]
        }
      ]
    }
  }
}
