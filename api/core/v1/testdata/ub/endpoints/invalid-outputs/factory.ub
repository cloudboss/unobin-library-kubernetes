factory: {
  imports:         { core: 'github.com/cloudboss/unobin-library-kubernetes//api/core/v1' }
  library-configs: { core: {} }
  data-sources: {
    endpoint: core.endpoints {
      metadata: { name: 'lookup.test' }
    }
  }
  outputs: {
    id: { value: data-source.endpoint.id }
    address: {
      value: [
        for item in data-source.endpoint.subset :
        [ for address in item.address : address.target-ref ]
      ]
    }
    port: {
      value: [
        for item in data-source.endpoint.subset :
        [ for port in item.port : port.app-protocol ]
      ]
    }
  }
}
