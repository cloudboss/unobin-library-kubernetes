factory: {
  imports: { apps: 'github.com/cloudboss/unobin-library-kubernetes//api/apps/v1' }
  inputs: {
    server:       { type: string }
    kind:         { type: string }
    name:         { type: string }
    namespace:    { type: optional(string) }
    expected-uid: { type: optional(string) }
    replicas:     { type: integer }
    timeout:      { type: optional(string) }
  }
  library-configs: { apps: { server: input.server, insecure-skip-tls-verify: true } }
  actions: {
    seed: apps.seed {
      values: {
        kind:         input.kind
        name:         input.name
        namespace:    input.namespace
        expected-uid: input.expected-uid
        replicas:     input.replicas
        timeout:      input.timeout
      }
    }
    scale: apps.scale {
      kind:         action.seed.resolved.kind
      name:         action.seed.resolved.name
      namespace:    action.seed.resolved.namespace
      expected-uid: action.seed.resolved.expected-uid
      replicas:     action.seed.resolved.replicas
      timeout:      action.seed.resolved.timeout
    }
  }
}
