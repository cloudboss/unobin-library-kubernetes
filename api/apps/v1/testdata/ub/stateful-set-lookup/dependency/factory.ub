factory: {
  imports:         { apps: 'github.com/cloudboss/unobin-library-kubernetes//api/apps/v1' }
  library-configs: { apps: { server: input.server, namespace: 'elsewhere' } }
  resources: {
    anchor: apps.anchor {
      value: input.epoch
    }
  }
  data-sources: {
    lookup: apps.stateful-set {
      @depends-on: [resource.anchor]
      metadata:    input.metadata
    }
  }
}
