factory: {
  imports: { certificates: 'github.com/cloudboss/unobin-library-kubernetes//api/certificates/v1' }
  library-configs: { certificates: {} }
  resources: {
    missing-metadata: certificates.certificate-signing-request {
      spec: { request: 'request', signer-name: 'example.test/signer' }
    }
    missing-spec: certificates.certificate-signing-request {
      metadata: { name: 'fixture' }
    }
    namespace: certificates.certificate-signing-request {
      metadata: { name: 'fixture', namespace: 'test' }
      spec:     { request: 'request', signer-name: 'example.test/signer' }
    }
    missing-request: certificates.certificate-signing-request {
      metadata: { name: 'fixture' }
      spec:     { signer-name: 'example.test/signer' }
    }
    missing-signer: certificates.certificate-signing-request {
      metadata: { name: 'fixture' }
      spec:     { request: 'request' }
    }
    null-request: certificates.certificate-signing-request {
      metadata: { name: 'fixture' }
      spec:     { request: null, signer-name: 'example.test/signer' }
    }
    null-signer: certificates.certificate-signing-request {
      metadata: { name: 'fixture' }
      spec:     { request: 'request', signer-name: null }
    }
    wrong-request: certificates.certificate-signing-request {
      metadata: { name: 'fixture' }
      spec:     { request: 1, signer-name: 'example.test/signer' }
    }
    wrong-signer: certificates.certificate-signing-request {
      metadata: { name: 'fixture' }
      spec:     { request: 'request', signer-name: true }
    }
    wrong-usage: certificates.certificate-signing-request {
      metadata: { name: 'fixture' }
      spec:     { request: 'request', signer-name: 'signer', usages: [1] }
    }
    wrong-label: certificates.certificate-signing-request {
      metadata: { name: 'fixture', labels: { key: 1 } }
      spec:     { request: 'request', signer-name: 'example.test/signer' }
    }
    only-id: certificates.certificate-signing-request {
      id: 'fixture'
    }
    ignored-annotations: certificates.certificate-signing-request {
      metadata:           { name: 'fixture' }
      spec:               { request: 'request', signer-name: 'example.test/signer' }
      ignore-annotations: ['.*']
    }
    ignored-labels: certificates.certificate-signing-request {
      metadata:      { name: 'fixture' }
      spec:          { request: 'request', signer-name: 'example.test/signer' }
      ignore-labels: ['.*']
    }
    volatile-outputs: certificates.certificate-signing-request {
      metadata: { name: 'fixture' }
      spec:     { request: 'request', signer-name: 'example.test/signer' }
    }
  }
  outputs: {
    status:     { value: resource.volatile-outputs.status }
    generation: { value: resource.volatile-outputs.metadata.generation }
    version:    { value: resource.volatile-outputs.metadata.resource-version }
  }
}
