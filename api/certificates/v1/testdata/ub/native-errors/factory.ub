factory: {
  imports: { certificates: 'github.com/cloudboss/unobin-library-kubernetes//api/certificates/v1' }
  library-configs: { certificates: {} }
  resources: {
    no-identity: certificates.certificate-signing-request {
      metadata: {}
      spec:     { request: 'request', signer-name: 'example.test/signer' }
    }
    null-identity: certificates.certificate-signing-request {
      metadata: { name: null, generate-name: null }
      spec:     { request: 'request', signer-name: 'example.test/signer' }
    }
    both-identities: certificates.certificate-signing-request {
      metadata: { name: 'fixture', generate-name: 'fixture-' }
      spec:     { request: 'request', signer-name: 'example.test/signer' }
    }
    empty-name: certificates.certificate-signing-request {
      metadata: { name: '' }
      spec:     { request: 'request', signer-name: 'example.test/signer' }
    }
    invalid-name: certificates.certificate-signing-request {
      metadata: { name: 'Invalid..name' }
      spec:     { request: 'request', signer-name: 'example.test/signer' }
    }
    long-name: certificates.certificate-signing-request {
      metadata: {
        name: '''\-
          aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
          aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
          aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
          '''
      }
      spec: { request: 'request', signer-name: 'example.test/signer' }
    }
    empty-prefix: certificates.certificate-signing-request {
      metadata: { generate-name: '' }
      spec:     { request: 'request', signer-name: 'example.test/signer' }
    }
    invalid-prefix: certificates.certificate-signing-request {
      metadata: { generate-name: 'invalid.dot-' }
      spec:     { request: 'request', signer-name: 'example.test/signer' }
    }
    long-prefix: certificates.certificate-signing-request {
      metadata: {
        generate-name: 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa-'
      }
      spec: { request: 'request', signer-name: 'example.test/signer' }
    }
    label-key: certificates.certificate-signing-request {
      metadata: { name: 'fixture', labels: { 'EXAMPLE.TEST/key': 'valid' } }
      spec:     { request: 'request', signer-name: 'example.test/signer' }
    }
    label-key-bound: certificates.certificate-signing-request {
      metadata: {
        name: 'fixture'
        labels: {
          'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/key': '''\-
            valid
            '''
        }
      }
      spec: { request: 'request', signer-name: 'example.test/signer' }
    }
    label-name-bound: certificates.certificate-signing-request {
      metadata: {
        name:   'fixture'
        labels: { aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa: '' }
      }
      spec: { request: 'request', signer-name: 'example.test/signer' }
    }
    label-value: certificates.certificate-signing-request {
      metadata: { name: 'fixture', labels: { key: 'bad/value' } }
      spec:     { request: 'request', signer-name: 'example.test/signer' }
    }
    label-value-bound: certificates.certificate-signing-request {
      metadata: {
        name:   'fixture'
        labels: { key: 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa' }
      }
      spec: { request: 'request', signer-name: 'example.test/signer' }
    }
    annotation-key: certificates.certificate-signing-request {
      metadata: { name: 'fixture', annotations: { 'invalid!/key': 'valid' } }
      spec:     { request: 'request', signer-name: 'example.test/signer' }
    }
    annotation-key-bound: certificates.certificate-signing-request {
      metadata: {
        name: 'fixture'
        annotations: {
          'AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA/K': '''\-
            ok
            '''
        }
      }
      spec: { request: 'request', signer-name: 'example.test/signer' }
    }
    annotation-name-bound: certificates.certificate-signing-request {
      metadata: {
        name:        'fixture'
        annotations: { AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA: 'ok' }
      }
      spec: { request: 'request', signer-name: 'example.test/signer' }
    }
    zero-timeout: certificates.certificate-signing-request {
      metadata:       { name: 'fixture' }
      spec:           { request: 'request', signer-name: 'example.test/signer' }
      create-timeout: '0s'
    }
    invalid-timeout: certificates.certificate-signing-request {
      metadata:       { name: 'fixture' }
      spec:           { request: 'request', signer-name: 'example.test/signer' }
      create-timeout: 'five'
    }
  }
}
