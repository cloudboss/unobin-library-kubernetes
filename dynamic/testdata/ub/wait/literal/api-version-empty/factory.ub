factory: {
  imports:         { dynamic: 'github.com/cloudboss/unobin-library-kubernetes//dynamic' }
  library-configs: { dynamic: {} }
  actions: {
    target: dynamic.wait {
      api-version: ''
      kind:        'ConfigMap'
      metadata:    { name: 'example' }
      exists:      true
    }
  }
}
