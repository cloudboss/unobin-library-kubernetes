factory: {
  imports: {
    core:    'github.com/cloudboss/unobin-library-kubernetes//api/core/v1'
    dynamic: 'github.com/cloudboss/unobin-library-kubernetes//dynamic'
  }
  library-configs: {
    core:    { server: input.server }
    dynamic: { server: input.server }
  }
  inputs: {
    server:     { type: string }
    defer-name: { type: boolean }
  }
  resources: {
    seed: core.config-map {
      object: { metadata: { name: 'seed', namespace: 'default' } }
    }
    selection: dynamic.labels {
      api-version: 'v1'
      kind:        'ConfigMap'
      metadata: {
        name: if input.defer-name then resource.seed.object.metadata.uid else 'example'
      }
      labels: { managed: 'desired' }
    }
  }
}
